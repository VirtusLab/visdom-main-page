---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import TourBanner from '../components/TourBanner.astro';
import Footer from '../components/Footer.astro';
import { WEBINAR, SPEAKERS, registrationHref, initials } from '../data/webinar';
import { SEQUEL, SEQUEL_TOOLKIT_SRC } from '../data/sequel';
import { TOUR_STOPS, TOUR_HREF } from '../data/tour';
import '../styles/global.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

// Registration happens on this page, in the Sequel embed. The mailto that used
// to be the CTA survives only as the having-trouble fallback under the widget.
const href = '#register';
const mailtoHref = registrationHref();

// The highlights band splits the session date into a display value and a mono
// label, both derived from the one startsAt in webinar.ts.
const startDate = WEBINAR.startsAt ? new Date(WEBINAR.startsAt) : null;
const hiDate = startDate
  ? startDate.toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long',
      timeZone: WEBINAR.timezone,
    })
  : 'To be announced';
const hiDateLabel = startDate
  ? `${startDate.toLocaleDateString('en-GB', { weekday: 'long', timeZone: WEBINAR.timezone })}, ${startDate.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: WEBINAR.timezone })} ${WEBINAR.timezoneLabel}`
  : 'Date and time';

// The session agenda, verbatim from the campaign brief. Do not reword these.
// Listed in running order: the session builds up to the demo and closes on Q&A.
const agenda = [
  'Why AI adoption often stalls after the first wave of excitement.',
  'What infrastructure is required for AI-native software delivery.',
  'A live demonstration of AI agents shipping production-ready code safely and at scale.',
  'How Visdom connects AI agents with your SDLC through its core components.',
  'Q&A with our expert.',
];

const siteUrl = import.meta.env.SITE || 'https://visdom.virtuslab.com';

// Emitted only once the date is known: an Event without a startDate is invalid
// structured data, and a half-filled block is worse than none.
const eventJsonLd = WEBINAR.startsAt
  ? {
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: WEBINAR.title,
      description: WEBINAR.subtitle,
      startDate: WEBINAR.startsAt,
      endDate: new Date(
        new Date(WEBINAR.startsAt).getTime() + WEBINAR.durationMinutes * 60_000,
      ).toISOString(),
      eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
      eventStatus: 'https://schema.org/EventScheduled',
      location: { '@type': 'VirtualLocation', url: `${siteUrl}/webinar` },
      image: [`${siteUrl}/og-image.png`],
      organizer: { '@type': 'Organization', name: 'VirtusLab', url: 'https://virtuslab.com' },
      performer: SPEAKERS.map((s) => ({
        '@type': 'Person',
        name: s.name,
        ...(s.role ? { jobTitle: s.role } : {}),
        worksFor: { '@type': 'Organization', name: s.company },
      })),
      offers: {
        '@type': 'Offer',
        price: 0,
        priceCurrency: 'EUR',
        availability: 'https://schema.org/InStock',
        url: `${siteUrl}/webinar#register`,
      },
    }
  : null;
---

<Layout title={`${WEBINAR.title} | Live webinar | Visdom by VirtusLab`} description={WEBINAR.subtitle}>
  {eventJsonLd && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(eventJsonLd)} />
  )}

  <TourBanner />
  <Nav />

  <main class="webinar">
    {/* ── HERO ───────────────────────────────────────────────────────────── */}
    {/* Editorial header in the Sequel masterclass shape: label, headline,
        lede, CTAs, then one hairline band holding the featuring row and the
        session-fact highlights. The embed is the next screen down. */}
    <section class="wb-hero">
      <div class="aurora" aria-hidden="true"></div>
      <div class="container wb-hero-inner">
        <div class="fade-up">
          <p class="section-label">Live webinar</p>

          <h1 class="wb-headline">
            Can your agents <span class="wb-headline-accent">actually ship?</span>
          </h1>

          <p class="wb-lede">
            AI coding assistants can write code. But can they actually deliver software?
          </p>

          <div class="wb-actions">
            <a
              class="btn-pill btn-primary"
              href={href}
              data-cta="webinar_register" data-location="webinar_hero"
            >
              Reserve your spot -&gt;
            </a>
            <a class="btn-pill btn-outline" href="#agenda" data-cta="webinar_agenda">See the agenda</a>
          </div>
        </div>

        <div class="wb-meta fade-up">
          <div class="wb-feat">
            <span class="wb-meta-label">Featuring</span>
            <div class="wb-feat-people">
              {SPEAKERS.map((s) => (
                <div class="wb-feat-person">
                  <span class="wb-plate" aria-hidden="true">
                    <img src={`${base}${s.photo}`} alt="" loading="lazy" onerror="this.remove()" />
                    <span>{initials(s.name)}</span>
                  </span>
                  <span class="wb-feat-text">
                    <b>{s.name}</b>
                    <span>{s.company}</span>
                  </span>
                </div>
              ))}
            </div>
          </div>

          <dl class="wb-hi">
            <div class="wb-hi-item">
              <dt class="wb-meta-label">{hiDateLabel}</dt>
              <dd>{hiDate}</dd>
            </div>
            <div class="wb-hi-item">
              <dt class="wb-meta-label">Live, with Q&amp;A</dt>
              <dd>{WEBINAR.durationMinutes} minutes</dd>
            </div>
            <div class="wb-hi-item">
              <dt class="wb-meta-label">Online session</dt>
              <dd>Free</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    {/* ── REGISTER ───────────────────────────────────────────────────────── */}
    {/* The Sequel embed carries the whole lifecycle in this one container:
        countdown and registration before the session, the live stage during
        it, the replay afterwards. The event schedule lives in Sequel; the
        widget renders it on its own. */}
    <section class="wb-register" id="register">
      <div class="container">
        <div class="wb-embed">
          <div id="sequel_root"></div>
        </div>
        <p class="wb-embed-fine">
          Having trouble registering? Email <a href={mailtoHref}>{WEBINAR.contactEmail}</a>.
        </p>
      </div>
      {/* Both tags must stay is:inline and in this order: Astro would otherwise
          bundle and hoist them, breaking the pairing between the vendor script
          and the Sequel.renderEvent call. */}
      <script is:inline src={SEQUEL_TOOLKIT_SRC}></script>
      <script is:inline define:vars={{ eventId: SEQUEL.eventId }}>
        (function () {
          function renderSequel() {
            window.Sequel.renderEvent({ eventId: eventId });
          }
          // DOMContentLoaded may already have fired by the time this runs.
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', renderSequel);
          } else {
            renderSequel();
          }
        })();
      </script>
    </section>

    {/* ── SPEAKERS ───────────────────────────────────────────────────────── */}
    {/* Roster between the embed and the premise: photo, name, role, company,
        bio and LinkedIn per person. Bios and role lines appear as the fields
        in SPEAKERS are filled in. */}
    <section class="wb-section wb-speakers-section">
      <div class="container">
        <h2 class="wb-h2 wb-speakers-h2 fade-up">Meet your speakers</h2>

        <div class="wb-speakers fade-up">
          {SPEAKERS.map((s) => (
            <article class="wb-speaker">
              <span class="wb-portrait" aria-hidden="true">
                <img src={`${base}${s.photo}`} alt="" loading="lazy" onerror="this.remove()" />
                <span>{initials(s.name)}</span>
              </span>
              <h3 class="wb-speaker-name">{s.name}</h3>
              {s.role && <p class="wb-speaker-role">{s.role}</p>}
              <p class="wb-speaker-company">{s.company}</p>
              {s.bio && <p class="wb-speaker-bio">{s.bio}</p>}
              {s.linkedin && (
                <a
                  class="wb-speaker-in"
                  href={s.linkedin}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${s.name} on LinkedIn`}
                  data-cta="webinar_speaker_linkedin"
                >
                  in
                </a>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ── THE PREMISE ────────────────────────────────────────────────────── */}
    <section class="wb-section section-alt">
      <div class="container">
        <h2 class="wb-h2 fade-up">The real bottleneck isn't the agent.</h2>

        <div class="wb-two-col fade-up">
          <p>
            Many engineering organizations discover that the real bottleneck is the
            delivery infrastructure.
          </p>
          <p>
            Pipelines, CI, code reviews, security gates, and release processes were
            designed for human speed, not AI.
          </p>
        </div>

        <div class="wb-pull fade-up">
          <span class="wb-pull-rule" aria-hidden="true"></span>
          <p>
            Visdom is the <span class="wb-accent">missing layer</span> between AI coding
            and production.
          </p>
        </div>
      </div>
    </section>

    {/* ── THE LAYER ──────────────────────────────────────────────────────── */}
    <section class="wb-section">
      <div class="container">
        <h2 class="wb-h2 fade-up">From AI-assisted delivery to an agent-operable SDLC</h2>
        <p class="wb-section-lead fade-up">
          Visdom provides the context, validation, governance, and orchestration that AI
          agents need to ship software safely and at scale.
        </p>

        <div class="wb-stack fade-up">
          <div class="wb-layer">
            <span class="wb-layer-name">Your AI agents</span>
            <p>AI coding assistants that can write code.</p>
          </div>

          <div class="wb-layer wb-layer-core">
            <span class="wb-layer-name">
              Visdom
              <em class="wb-mono">The missing layer</em>
            </span>
            <div>
              <div class="wb-chips">
                {['Context', 'Validation', 'Governance', 'Orchestration'].map((c) => (
                  <span class="wb-chip">{c}</span>
                ))}
              </div>
              <p>What AI agents need to ship software safely and at scale.</p>
            </div>
          </div>

          <div class="wb-layer">
            <span class="wb-layer-name">Your SDLC</span>
            <p>Pipelines, CI, code reviews, security gates, and release processes.</p>
          </div>
        </div>
      </div>
    </section>

    {/* ── AGENDA ─────────────────────────────────────────────────────────── */}
    <section class="wb-section section-alt" id="agenda">
      <div class="container">
        <h2 class="wb-h2 fade-up">During this live session, we'll cover</h2>

        <ol class="wb-agenda fade-up" role="list">
          {agenda.map((item, i) => (
            <li class="wb-agenda-item">
              <span class="wb-agenda-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <p>{item}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ── ON THE TOUR ────────────────────────────────────────────────────── */}
    {/* The related-content beat at the end of the body: the webinar as one
        stop on the Visdom AI Tour, the same demo we run on stage. */}
    <section class="wb-section">
      <div class="container">
        <p class="section-label fade-up">Visdom AI Tour</p>
        <h2 class="wb-h2 fade-up">This demo normally runs in the room.</h2>
        <p class="wb-section-lead fade-up">
          We take it on the road: tech-week talks, conference sessions, and roundtables
          with engineering teams. The webinar is that same session, opened up to everyone
          who cannot make a stop in person.
        </p>

        <figure class="wb-tour-gallery fade-up">
          <img
            class="wb-tour-wide"
            src={`${base}/track-record-tour.jpg`}
            width="2000"
            height="1431"
            loading="lazy"
            decoding="async"
            alt="VirtusLab engineers at an AI infrastructure conference, in Can Your AI Agents Actually Ship shirts."
          />
          <img
            src={`${base}/tour-aiworld-booth.jpg`}
            width="1600"
            height="1200"
            loading="lazy"
            decoding="async"
            alt="The VirtusLab booth at AI World Congress in London, with the team talking to attendees on the expo floor."
          />
          <img
            src={`${base}/tour-aiworld-stage.jpg`}
            width="1000"
            height="1333"
            loading="lazy"
            decoding="async"
            alt="A VirtusLab speaker on the main stage at AI World Congress in London."
          />
          <figcaption>Out in the field on the Visdom AI Tour.</figcaption>
        </figure>

        <ul class="wb-tour-stops fade-up">
          {TOUR_STOPS.map((stop) => (
            <li class={`wb-tour-stop wb-tour-stop-${stop.status}`}>
              <span class="wb-tour-flag" aria-hidden="true">{stop.flag}</span>
              <span class="wb-tour-city">{stop.city}</span>
              <span class="wb-tour-when">{stop.when}</span>
            </li>
          ))}
        </ul>

        <a
          class="wb-tour-link fade-up"
          href={TOUR_HREF}
          target="_blank"
          rel="noopener"
          data-cta="webinar_tour"
        >
          See the full tour -&gt;
        </a>
      </div>
    </section>

    {/* ── CLOSING ────────────────────────────────────────────────────────── */}
    <section class="wb-final">
      <div class="aurora" aria-hidden="true"></div>
      <div class="container">
        {/* The brief's closing paragraph carries this section. It is the beat, so
            it is set at display scale rather than under an invented headline. */}
        <p class="wb-final-statement fade-up">
          Whether you're exploring AI coding assistants or already introducing them into
          your engineering organization, this webinar will show what it takes to move
          beyond code generation and enable AI agents to become productive contributors to
          your software delivery process.
        </p>
        <p class="wb-final-note fade-up">
          Register to reserve your spot.{!WEBINAR.startsAt && ' Registrants get the invite as soon as the date is set.'}
        </p>
        <div class="wb-final-cta fade-up">
          <a
            class="btn-pill btn-primary"
            href={href}
            data-cta="webinar_register" data-location="webinar_final"
          >
            Reserve your spot -&gt;
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  import { SEQUEL_ORIGIN } from '../data/sequel';

  // Sequel reports what happens inside its frame over postMessage. A completed
  // registration becomes the same generate_lead the mailto CTA used to stand
  // in for, so the GA4 funnel stays comparable across the switch.
  window.addEventListener('message', (e) => {
    if (e.origin !== SEQUEL_ORIGIN) return;
    const name = (e.data as { event?: string } | null)?.event;
    const gtag = (window as any).gtag;
    if (name !== 'user-registered' || typeof gtag !== 'function') return;
    gtag('event', 'generate_lead', {
      method: 'sequel',
      cta_id: 'webinar_register',
      location: 'webinar_embed',
    });
  });
</script>

<style>
  /* ── Shared type roles ─────────────────────────────────────────────────── */
  .wb-mono {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .wb-accent {
    color: var(--color-emerald-dark);
  }

  :global(.dark) .wb-accent {
    color: var(--color-emerald);
  }

  .wb-section {
    position: relative;
    padding: clamp(4rem, 7vw, 6.5rem) 0;
  }

  .wb-h2 {
    margin: 0;
    max-width: 26ch;
    /* Keeps two-line headings from leaving a single orphan word on line two. */
    text-wrap: balance;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.12;
    color: var(--color-text);
  }

  .wb-section-lead {
    margin: 1.25rem 0 0;
    max-width: 62ch;
    font-size: var(--fs-xl);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* ── Hero ──────────────────────────────────────────────────────────────── */
  .wb-hero {
    position: relative;
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
  }

  .wb-hero-inner {
    position: relative;
    z-index: 1;
  }

  .wb-headline {
    margin: 0.75rem 0 0;
    max-width: 16ch;
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4.6vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.04;
    color: var(--color-text);
  }

  /* Emphasis stays in the same family. inline-block plus padding reserves room
     for the descenders in "actually ship?". */
  .wb-headline-accent {
    display: inline-block;
    font-style: italic;
    line-height: 1.1;
    padding-bottom: 0.06em;
    color: var(--color-emerald-dark);
  }

  :global(.dark) .wb-headline-accent {
    color: var(--color-emerald);
  }

  .wb-lede {
    margin: 1.5rem 0 0;
    max-width: 44ch;
    font-size: var(--fs-2xl);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .wb-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* ── Featuring + highlights band ───────────────────────────────────────── */
  /* One hairline band under the hero copy: who is presenting on the left,
     the three session facts on the right. */
  .wb-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: clamp(2.25rem, 4vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .wb-meta-label {
    display: block;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-3xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .wb-feat-people {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin-top: 0.75rem;
  }

  .wb-feat-person {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .wb-feat-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .wb-feat-text b {
    font-size: var(--fs-md);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .wb-feat-text span {
    font-size: var(--fs-xs);
    color: var(--color-text-secondary);
  }

  .wb-hi {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    margin: 0;
  }

  .wb-hi-item dd {
    margin: 0.4rem 0 0;
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  /* ── Host portrait plate ───────────────────────────────────────────────── */
  /* The img sits over the initials and removes itself when the file is absent,
     so a missing headshot degrades to a plate instead of a broken image. */
  .wb-plate {
    position: relative;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface-light);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .wb-plate img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Register embed ────────────────────────────────────────────────────── */
  .wb-register {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(3rem, 5vw, 4.5rem);
  }

  .wb-embed {
    /* Sequel manages everything inside the root, including its own sizing.
       The container caps the width; this only stops any fixed-width internals
       from pushing the page wider than the viewport on small screens. */
    max-width: 100%;
    overflow-x: hidden;
  }

  .wb-embed :global(#sequel_root) {
    width: 100%;
  }

  .wb-embed :global(iframe) {
    max-width: 100%;
  }

  .wb-embed-fine {
    margin: 1.25rem 0 0;
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .wb-embed-fine a {
    color: var(--color-text-secondary);
    text-decoration: underline;
  }

  /* ── Speakers ──────────────────────────────────────────────────────────── */
  .wb-speakers-section {
    padding-top: 0;
    text-align: center;
  }

  .wb-speakers-h2 {
    max-width: none;
  }

  .wb-speakers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    max-width: 60rem;
    margin: clamp(2rem, 4vw, 3rem) auto 0;
  }

  .wb-speaker {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Round portrait in the reference's shape; the img removes itself when the
     headshot file is absent and the initials plate shows instead. */
  .wb-portrait {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(6.5rem, 9vw, 8rem);
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background: var(--color-surface-light);
    font-family: var(--font-mono);
    font-size: var(--fs-2xl);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .wb-portrait img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wb-speaker-name {
    margin: 1.1rem 0 0;
    font-size: var(--fs-xl);
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-text);
  }

  .wb-speaker-role {
    margin: 0.35rem 0 0;
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .wb-speaker-company {
    margin: 0.25rem 0 1rem;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .wb-speaker-bio {
    margin: 0 0 1rem;
    max-width: 34ch;
    font-size: var(--fs-sm);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .wb-speaker-in {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    /* auto top margin pins the roundel to the card bottom, so the three links
       sit on one line even while bios differ in length. */
    margin-top: auto;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background: var(--color-surface);
    font-family: var(--font-heading);
