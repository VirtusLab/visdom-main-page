---
/**
 * /webinar-sequel: the webinar landing page with the session hosted in the page
 * by Sequel.io instead of handing people off to a mailto and a Zoom link.
 *
 * Same copy and same session data as /webinar. The only difference is the
 * mechanism: one embed carries registration before the session, the live room
 * during it, and the replay afterwards, so there is a single URL to link to and
 * nothing to swap over on the day.
 *
 * noindex, because it is a second page carrying the first page's copy. Two
 * indexable near-duplicates would compete with each other. It comes off noindex
 * on the day this replaces /webinar.
 *
 * Sequel ids live in src/data/sequel.ts. While eventId is empty the session
 * panel keeps its own registration CTA, the same one /webinar uses today, so
 * the page works either way.
 */
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import TourBanner from '../components/TourBanner.astro';
import Footer from '../components/Footer.astro';
import {
  WEBINAR,
  registrationHref,
  formatSessionDate,
  hostInitials,
} from '../data/webinar';
import {
  SEQUEL,
  SEQUEL_IFRAME_ALLOW,
  SEQUEL_ORIGIN,
  sequelEventUrl,
  isConfigured,
} from '../data/sequel';
import '../styles/global.css';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const sessionDate = formatSessionDate();
const initials = hostInitials();
const eventUrl = sequelEventUrl();
const embedded = isConfigured();

const fallbackHref = registrationHref();
const fallbackExternal = fallbackHref.startsWith('http');

// Verbatim from the campaign brief, same as /webinar. Do not reword.
const agenda = [
  'Why AI adoption often stalls after the first wave of excitement.',
  'What infrastructure is required for AI-native software delivery.',
  'A live demonstration of AI agents shipping production-ready code safely and at scale.',
  'How Visdom connects AI agents with your SDLC through its core components.',
  'Q&A with our expert.',
];

const siteUrl = import.meta.env.SITE || 'https://visdom.virtuslab.com';
const eventJsonLd = WEBINAR.startsAt
  ? {
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: WEBINAR.title,
      description: WEBINAR.subtitle,
      startDate: WEBINAR.startsAt,
      endDate: new Date(
        new Date(WEBINAR.startsAt).getTime() + WEBINAR.durationMinutes * 60_000,
      ).toISOString(),
      eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
      eventStatus: 'https://schema.org/EventScheduled',
      location: { '@type': 'VirtualLocation', url: `${siteUrl}/webinar-sequel` },
      image: [`${siteUrl}/og-image.png`],
      organizer: { '@type': 'Organization', name: 'VirtusLab', url: 'https://virtuslab.com' },
      performer: {
        '@type': 'Person',
        name: WEBINAR.host.name,
        jobTitle: WEBINAR.host.role,
        worksFor: { '@type': 'Organization', name: WEBINAR.host.company },
      },
    }
  : null;
---
<Layout
  title={`${WEBINAR.title} | Live webinar | Visdom by VirtusLab`}
  description={WEBINAR.subtitle}
  noindex={true}
>
  {eventJsonLd && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(eventJsonLd)} />
  )}

  <TourBanner />
  <Nav />

  <main class="sq">
    {/* ── HERO ───────────────────────────────────────────────────────────── */}
    <section class="sq-hero">
      <div class="aurora" aria-hidden="true"></div>
      <div class="container sq-hero-grid">
        <div class="fade-up">
          <p class="section-label">Live webinar</p>
          <h1 class="sq-headline">
            Can your agents <span class="sq-accent">actually ship?</span>
          </h1>
          <p class="sq-lede">
            AI coding assistants can write code. But can they actually deliver software?
          </p>
          <div class="sq-actions">
            <a class="btn-pill btn-primary" href="#session" data-cta="webinar_register" data-location="webinar_sequel_hero">
              Take your seat -&gt;
            </a>
            <a class="btn-pill btn-outline" href="#agenda">See the agenda</a>
          </div>
        </div>

        <div class="fade-up card sq-session-card">
          <div class="sq-session-head"><span class="sq-mono">Session details</span></div>
          <dl class="sq-session-rows">
            <div class="sq-session-row"><dt>Date</dt><dd>{sessionDate}</dd></div>
            <div class="sq-session-row"><dt>Runtime</dt><dd>{WEBINAR.durationMinutes} minutes</dd></div>
            <div class="sq-session-row"><dt>Format</dt><dd>Live, with Q&amp;A</dd></div>
            <div class="sq-session-row"><dt>Price</dt><dd class="sq-session-accent">Free</dd></div>
          </dl>
          <div class="sq-session-host">
            <span class="sq-plate" aria-hidden="true">{initials}</span>
            <span class="sq-session-host-text">
              <b>{WEBINAR.host.name}</b>
              <span>{WEBINAR.host.role}, {WEBINAR.host.company}</span>
            </span>
          </div>
        </div>
      </div>
    </section>

    {/* ── THE SESSION: registration, live room and replay, all in one frame ─ */}
    <section class="sq-section" id="session">
      <div class="container">
        <p class="section-label fade-up">The session</p>
        <h2 class="sq-h2 fade-up">Everything happens on this page</h2>
        <p class="sq-section-lead fade-up">
          Sign up here, watch here, and come back to the same address for the recording.
          No other platform, no separate link in your calendar.
        </p>

        <div
          class="sq-stage fade-up"
          id="sq-stage"
          data-embed-url={eventUrl ?? ''}
          data-allow={SEQUEL_IFRAME_ALLOW}
          data-origin={SEQUEL_ORIGIN}
        >
          {embedded && !SEQUEL.clickToLoad ? (
            <iframe
              src={eventUrl}
              title={WEBINAR.title}
              allow={SEQUEL_IFRAME_ALLOW}
              allowfullscreen
              loading="lazy"
            ></iframe>
          ) : (
            <div class="sq-panel" id="sq-panel">
              <div class="sq-panel-body">
                <p class="sq-panel-kicker sq-mono">Live webinar</p>
                <p class="sq-panel-title">{WEBINAR.title}</p>
                <p class="sq-panel-meta">
                  <span>{sessionDate}</span>
                  <span aria-hidden="true">·</span>
                  <span>{WEBINAR.durationMinutes} min</span>
                  <span aria-hidden="true">·</span>
                  <span>Free</span>
                </p>

                {embedded ? (
                  <>
                    <button type="button" class="btn-pill btn-primary sq-panel-cta" id="sq-load">
                      Reserve your seat -&gt;
                    </button>
                    <p class="sq-panel-fine">
                      Opens the session player on this page.
                    </p>
                  </>
                ) : (
                  <>
                    <a
                      class="btn-pill btn-primary sq-panel-cta"
                      href={fallbackHref}
                      target={fallbackExternal ? '_blank' : undefined}
                      rel={fallbackExternal ? 'noopener' : undefined}
                      data-cta="webinar_register"
                      data-location="webinar_sequel_panel"
                    >
                      Reserve your seat -&gt;
                    </a>
                    <p class="sq-panel-fine">
                      We will send the joining details and the recording afterwards.
                    </p>
                  </>
                )}

                <div class="sq-panel-host">
                  <span class="sq-plate" aria-hidden="true">{initials}</span>
                  <span>Hosted by <b>{WEBINAR.host.name}</b>, {WEBINAR.host.role}</span>
                </div>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>

    {/* ── THE PREMISE ────────────────────────────────────────────────────── */}
    <section class="sq-section section-alt">
      <div class="container">
        <h2 class="sq-h2 fade-up">The real bottleneck isn't the agent.</h2>
        <div class="sq-two-col fade-up">
          <p>
            Many engineering organizations discover that the real bottleneck is the
            delivery infrastructure.
          </p>
          <p>
            Pipelines, CI, code reviews, security gates, and release processes were
            designed for human speed, not AI.
          </p>
        </div>
        <div class="sq-pull fade-up">
          <span class="sq-pull-rule" aria-hidden="true"></span>
          <p>
            Visdom is the <span class="sq-accent">missing layer</span> between AI coding
            and production.
          </p>
        </div>
      </div>
    </section>

    {/* ── AGENDA ─────────────────────────────────────────────────────────── */}
    <section class="sq-section" id="agenda">
      <div class="container">
        <p class="section-label fade-up">Agenda</p>
        <h2 class="sq-h2 fade-up">During this live session, we'll cover</h2>
        <ol class="sq-agenda fade-up" role="list">
          {agenda.map((item, i) => (
            <li class="sq-agenda-item">
              <span class="sq-agenda-n sq-mono">{String(i + 1).padStart(2, '0')}</span>
              <p>{item}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ── HOST ───────────────────────────────────────────────────────────── */}
    <section class="sq-section section-alt">
      <div class="container">
        <p class="section-label fade-up">Your host</p>
        <div class="sq-host fade-up">
          <span class="sq-plate sq-plate-lg" aria-hidden="true">{initials}</span>
          <div>
            <h2 class="sq-host-name">{WEBINAR.host.name}</h2>
            <p class="sq-mono sq-host-role">{WEBINAR.host.role}, {WEBINAR.host.company}</p>
            <p class="sq-host-bio">
              {WEBINAR.host.name} will demonstrate how Visdom turns AI-assisted software
              delivery into an agent-operable SDLC: how agents can move through the whole
              lifecycle with the context, validation, governance, and orchestration they
              need to ship production-ready software.
            </p>
            {WEBINAR.host.note && <p class="sq-host-note">{WEBINAR.host.note}</p>}
          </div>
        </div>
      </div>
    </section>

    {/* ── CLOSE ──────────────────────────────────────────────────────────── */}
    <section class="sq-final">
      <div class="aurora" aria-hidden="true"></div>
      <div class="container">
        <p class="sq-final-statement fade-up">
          Whether you're exploring AI coding assistants or already introducing them into
          your engineering organization, this session shows what it takes to move from
          writing code to shipping it.
        </p>
        <div class="sq-final-actions fade-up">
          <a class="btn-pill btn-primary" href="#session" data-cta="webinar_register" data-location="webinar_sequel_final">
            Take your seat -&gt;
          </a>
          <a class="btn-pill btn-outline" href={`${base}/`}>Explore the platform</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const stage = document.getElementById('sq-stage');
  const origin = stage?.dataset.origin ?? '';

  // The frame is injected on click rather than at load: it sets third-party
  // cookies and asks for camera and microphone, which should wait for intent.
  document.getElementById('sq-load')?.addEventListener('click', () => {
    const url = stage?.dataset.embedUrl;
    if (!stage || !url) return;
    const frame = document.createElement('iframe');
    frame.src = url;
    frame.title = 'Webinar session';
    frame.allow = stage.dataset.allow ?? '';
    frame.allowFullscreen = true;
    document.getElementById('sq-panel')?.remove();
    stage.appendChild(frame);
  });

  // Sequel reports what happens inside the frame over postMessage. Mapped onto
  // the GA4 vocabulary Analytics.astro already uses, so a signup here is the
  // same generate_lead the mailto CTA fires and the funnel stays comparable.
  window.addEventListener('message', (e) => {
    if (!origin || e.origin !== origin) return;
    const name = e.data?.event;
    const data = e.data?.data ?? {};
    const gtag = (window as any).gtag;
    if (!name || typeof gtag !== 'function') return;

    if (name === 'user-registered') {
      gtag('event', 'generate_lead', {
        method: 'sequel',
        cta_id: 'webinar_register',
        location: 'webinar_sequel_embed',
      });
    } else if (name === 'event-started' || name === 'event-ended') {
      gtag('event', name.replace('-', '_'), { location: 'webinar_sequel_embed' });
    } else if (name === 'cta-updated' && data.showing) {
      gtag('event', 'cta_click', {
        cta_id: 'sequel_in_session',
        location: 'webinar_sequel_embed',
      });
    }
  });
</script>

<style>
  .sq { background: var(--color-bg); }

  /* ---- hero ---- */
  .sq-hero { position: relative; overflow: hidden; padding: 5rem 0 3.5rem; }
  .sq-hero-grid { position: relative; z-index: 1; display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 900px) {
    .sq-hero-grid { grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr); gap: 3.5rem; }
  }
  .sq-headline {
    font-family: var(--font-heading);
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    font-weight: 700; letter-spacing: -0.035em; line-height: 1.05;
    color: var(--color-text); margin: 0.6rem 0 1rem;
  }
  .sq-accent { color: var(--vmm-accent); }
  .sq-lede { font-size: var(--fs-lg); color: var(--color-text-secondary); line-height: 1.6; max-width: 32rem; }
  .sq-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 2rem; }

  /* ---- session details card ---- */
  .sq-session-card { padding: 20px; }
  .sq-session-head { padding-bottom: 12px; border-bottom: 1px solid var(--color-border-light); }
  .sq-mono {
    font-family: var(--font-mono); font-size: var(--fs-2xs);
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-text-muted);
  }
  .sq-session-rows { margin: 14px 0 0; display: grid; gap: 10px; }
  .sq-session-row { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  .sq-session-row dt { font-size: var(--fs-sm); color: var(--color-text-muted); margin: 0; }
  .sq-session-row dd { font-size: var(--fs-sm); color: var(--color-text); font-weight: 500; margin: 0; text-align: right; }
  .sq-session-accent { color: var(--color-emerald) !important; }
  .sq-session-host {
    display: flex; align-items: center; gap: 10px;
    margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--color-border-light);
  }
  .sq-session-host-text { display: flex; flex-direction: column; }
  .sq-session-host-text b { font-size: var(--fs-sm); color: var(--color-text); }
  .sq-session-host-text span { font-size: var(--fs-2xs); color: var(--color-text-muted); }

  .sq-plate {
    display: grid; place-items: center; flex: 0 0 auto;
    width: 36px; height: 36px; border-radius: 9999px;
    background: var(--color-surface); border: 1px solid var(--color-border);
    font-family: var(--font-mono); font-size: var(--fs-2xs); font-weight: 700;
    color: var(--color-text-secondary);
  }
  .sq-plate-lg { width: 76px; height: 76px; font-size: var(--fs-lg); }

  /* ---- sections ---- */
  .sq-section { padding: 4.5rem 0; }
  .sq-h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
    font-weight: 700; letter-spacing: -0.03em; color: var(--color-text);
    margin: 0.6rem 0 0.9rem;
  }
  .sq-section-lead { color: var(--color-text-secondary); line-height: 1.65; max-width: 44rem; margin-bottom: 2.25rem; }

  /* ---- the embed / session panel ---- */
  .sq-stage {
    position: relative; display: grid;
    border-radius: 16px; overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    min-height: min(78vh, 600px);
    box-shadow: 0 1px 3px rgba(0,0,0,.04), 0 18px 50px rgba(0,0,0,.07);
  }
  .sq-stage :global(iframe) { width: 100%; height: min(78vh, 600px); border: 0; display: block; }

  .sq-panel {
    display: grid; place-items: center; padding: 2.5rem 1.5rem; text-align: center;
    background:
      radial-gradient(900px 320px at 50% -5%, var(--vmm-accent-soft), transparent 70%),
      var(--color-surface);
  }
  .sq-panel-body { display: grid; gap: 12px; justify-items: center; max-width: 34rem; }
  .sq-panel-kicker { margin: 0; }
  .sq-panel-title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.4vw, 2.25rem);
    font-weight: 700; letter-spacing: -0.03em; line-height: 1.15;
    color: var(--color-text); margin: 0;
  }
  .sq-panel-meta {
    display: flex; flex-wrap: wrap; gap: 8px; justify-content: center;
    font-size: var(--fs-sm); color: var(--color-text-secondary); margin: 0;
  }
  .sq-panel-cta { margin-top: 8px; }
  .sq-panel-fine { font-size: var(--fs-2xs); color: var(--color-text-muted); margin: 0; }
  .sq-panel-host {
    display: flex; align-items: center; gap: 10px;
    margin-top: 14px; padding-top: 16px;
    border-top: 1px solid var(--color-border-light);
    font-size: var(--fs-sm); color: var(--color-text-secondary);
  }
  .sq-panel-host b { color: var(--color-text); }

  /* ---- premise ---- */
  .sq-two-col { display: grid; gap: 1.25rem; max-width: 52rem; }
  @media (min-width: 800px) { .sq-two-col { grid-template-columns: 1fr 1fr; gap: 2rem; } }
  .sq-two-col p { color: var(--color-text-secondary); line-height: 1.65; margin: 0; }
  .sq-pull { display: flex; gap: 16px; margin-top: 2.5rem; max-width: 40rem; }
  .sq-pull-rule { flex: 0 0 3px; border-radius: 3px; background: var(--vmm-accent); }
  .sq-pull p {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    font-weight: 600; letter-spacing: -0.02em; line-height: 1.3;
    color: var(--color-text); margin: 0;
  }

  /* ---- agenda ---- */
  .sq-agenda { display: grid; gap: 10px; max-width: 46rem; }
  .sq-agenda-item {
    display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: start;
    padding: 16px; border-radius: 12px;
    border: 1px solid var(--color-border-light); background: var(--color-surface);
  }
  .sq-agenda-item p { margin: 0; color: var(--color-text); line-height: 1.55; }
  .sq-agenda-n { color: var(--vmm-accent); padding-top: 2px; }

  /* ---- host ---- */
  .sq-host { display: grid; gap: 1.25rem; align-items: start; max-width: 48rem; }
  @media (min-width: 700px) { .sq-host { grid-template-columns: auto 1fr; gap: 1.75rem; } }
  .sq-host-name { font-family: var(--font-heading); font-size: var(--fs-3xl); font-weight: 700; color: var(--color-text); margin: 0 0 4px; }
  .sq-host-role { margin: 0 0 12px; }
  .sq-host-bio { color: var(--color-text-secondary); line-height: 1.65; margin: 0; }
  .sq-host-note { margin: 10px 0 0; font-size: var(--fs-sm); color: var(--color-text-muted); }

  /* ---- close ---- */
  .sq-final { position: relative; overflow: hidden; padding: 5rem 0 6rem; text-align: center; }
  .sq-final > .container { position: relative; z-index: 1; }
  .sq-final-statement {
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-weight: 600; letter-spacing: -0.025em; line-height: 1.35;
    color: var(--color-text); margin: 0 auto; max-width: 44rem;
  }
  .sq-final-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 2rem; }
</style>
