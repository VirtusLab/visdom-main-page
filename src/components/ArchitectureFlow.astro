---
// Architecture Flow: scroll-driven, ambient-animated SVG of the Visdom
// AI software-engineering architecture. See docs/architecture-flow.md.
// Edit the data arrays below to add/rename sources, tests, review levels,
// triage branches, or the scroll captions.

import { useI18n, fill } from '../i18n';

const { t } = useI18n(Astro);
const d = t.architecture.diagram;

const sourceIcons = ['jira', 'git', 'chat', 'repo', 'docs', 'org'];
const sources = d.sources.map((label, i) => ({ label, icon: sourceIcons[i] }));

// Lucide-style line icons (24x24), drawn via set:html inside the source nodes.
const icons: Record<string, string> = {
  jira: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 7v10M12 7v7M16 7v4"/>',
  git: '<circle cx="12" cy="12" r="3"/><path d="M3 12h6M15 12h6"/>',
  chat: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  repo: '<line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>',
  docs: '<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/><path d="M14 2v5h5"/><path d="M16 13H8M16 17H8M10 9H8"/>',
  org: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  pr: '<circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="18" r="3"/><path d="M6 9v6"/><path d="M13 6h2a3 3 0 0 1 3 3v6"/>',
  rocket: '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
};

/*
 * Module glyphs. The restyle drops the line icons in module headers for a small
 * solid mark per component, which is what carries the colour coding: each module
 * owns one accent and the glyph is the only place it appears at full strength.
 * All drawn in a 10x10 box so they can be placed by translate alone.
 */
const glyphs = {
  dot: '<circle cx="5" cy="5" r="5" />',
  ring: '<circle cx="5" cy="5" r="3.9" fill="none" stroke-width="2.2" />',
  diamond: '<rect x="0.8" y="0.8" width="8.4" height="8.4" rx="1.5" transform="rotate(45 5 5)" />',
  square: '<rect x="0" y="0" width="10" height="10" rx="2.4" />',
};

const testLayers = d.testLayers;
const reviewLevels = d.reviewLevels;

// AppSec scans on the same PR, powered by Aikido (reachability-based triage)
const securityLayers = d.securityLayers;

const captions = t.architecture.captions;

// Ambient particles. Each rides an SVG path (by id) via GSAP MotionPath.
// `stage` ties the particle to the reveal step that owns its path.
// `pause` > 0 turns the dot into a discrete "packet": fade in, travel once,
// fade out, wait, repeat. Without `pause` it loops continuously (the context loop).
// Discrete "packet" dots remain only where they read as items (knowledge in,
// traces down). Lines that carry flow use CSS light streaks instead.
const particles = [
  // knowledge drops from each source into the fabric bar (stage 0)
  ...sources.map((_, i) => ({ path: `af-w${i}`, dur: 1.0, delay: i * 0.4, pause: 1.6, tone: 'ctx', stage: 0 })),
  // traces drop into the vault (stage 8), production drops its own (stage 9)
  { path: 'af-t0', dur: 1.2, delay: 0, pause: 1.8, tone: 'trace', stage: 8 },
  ...[1, 2, 3].map((i) => ({ path: `af-t${i}`, dur: 0.7, delay: i * 0.5, pause: 1.8, tone: 'trace', stage: 8 })),
  { path: 'af-tsec', dur: 0.7, delay: 2.0, pause: 1.8, tone: 'trace', stage: 8 },
  { path: 'af-t4', dur: 1.4, delay: 0.4, pause: 2.0, tone: 'trace', stage: 9 },
];
const particleStages = [...new Set(particles.map((p) => p.stage))];

// layout helpers: sources run horizontally, fabric is a bar like the vault
const srcX = (i: number) => 44 + i * 202;
const srcCX = (i: number) => 134 + i * 202;
const testY = (i: number) => 304 + i * 40;
const revW = [178, 178, 178, 178];
const revX = [486, 486, 486, 486];
const revY = (i: number) => 304 + i * 40;
---

<section class="af" id="how-it-works" aria-labelledby="af-title">
  <div class="container af-head">
    <p class="section-label">{t.architecture.label}</p>
    <h2 id="af-title" class="section-title">{t.architecture.title}</h2>
    <p class="section-subtitle">
      {t.architecture.subtitle.lead}
      {t.architecture.subtitle.beforeLinks} <a href="https://virtuslab.github.io/visdom-testing/" target="_blank" rel="noopener">{t.architecture.subtitle.testing}</a>,
      <a href="https://virtuslab.github.io/visdom-code-review/" target="_blank" rel="noopener">{t.architecture.subtitle.review}</a>,
      <a href="https://virtuslab.github.io/visdom-security/" target="_blank" rel="noopener">{t.architecture.subtitle.security}</a> {t.architecture.subtitle.afterLinks}
      <a href="https://virtuslab.github.io/visdom-governance/" target="_blank" rel="noopener">{t.architecture.subtitle.tracing}</a> {t.architecture.subtitle.tail}
    </p>
  </div>

  <div class="af-track">
    <div class="af-viewport">
      <div class="af-stage">
        <svg viewBox="0 0 1280 680" role="img" aria-labelledby="af-svg-title" class="af-svg" preserveAspectRatio="xMidYMid meet">
          <title id="af-svg-title">{t.architecture.svgTitle}</title>

          <defs>
            <!-- arrowheads only on the amber human-gate paths, green flow relies on the streaks -->
            <marker id="af-arrow-amber" viewBox="0 0 12 9" refX="11" refY="4.5" markerWidth="7" markerHeight="5.25" orient="auto-start-reverse">
              <path d="M0,0.5 L12,4.5 L0,8.5 L3.2,4.5 Z" class="af-arrowhead--amber" />
            </marker>
            <pattern id="af-grid" width="26" height="26" patternUnits="userSpaceOnUse">
              <circle cx="1" cy="1" r="1" class="af-grid-dot" />
            </pattern>
          </defs>

          <!-- blueprint substrate: dot grid + corner registration marks -->
          <rect x="36" y="40" width="1208" height="600" fill="url(#af-grid)" class="af-bp" aria-hidden="true" />
          <g class="af-fid" aria-hidden="true">
            {[[40, 44], [1240, 44], [40, 658], [1240, 658]].map(([x, y]) => (
              <path d={`M${x - 5},${y} H${x + 5} M${x},${y - 5} V${y + 5}`} />
            ))}
          </g>

          <!-- ============ ORCHESTRATOR (the enclosure: the whole engine room) ============ -->
          <!-- everything between the Context Fabric above and AI Tracing below lives
               inside the orchestrator: preflight, the coding agent, testing, review and
               risk triage. Production sits OUTSIDE, to the right. Drawn first so the
               spine, panels and PR envelope all render on top of its soft fill. -->
          <g id="af-orchestrator" class="af-group" data-reveal>
            <rect x="44" y="228" width="1014" height="334" rx="20" class="af-orch-box" />
            {/* title as a legend riding the top border, with the engine credit underneath */}
            <rect x="439" y="206" width="224" height="44" rx="9" class="af-orch-legend" />
            <g class="af-glyph af-glyph--orch" transform="translate(457,210)" set:html={glyphs.ring} />
            <text x="480" y="225" class="af-orch-label">{d.orchestrator}</text>
            <text x="551" y="242" text-anchor="middle" class="af-orch-sub">{d.orchestratorSub}</text>
          </g>

          <!-- ============ AI TRACING (baseplate, spans everything) ============ -->
          <g id="af-tracing" class="af-group" data-reveal>
            <rect x="44" y="578" width="1192" height="68" rx="18" class="af-vault" />
            <line x1="60" y1="579.5" x2="1220" y2="579.5" class="af-sheen" />
            <g class="af-glyph af-glyph--tracing" transform="translate(66,607)" set:html={glyphs.dot} />
            <text x="94" y="619" class="af-vault-label">{d.vault}</text>
            {/* hash-chain motif: linked blocks, append-only */}
            <g class="af-chain" aria-hidden="true">
              {[1020, 1048, 1076, 1104].map((x, i) => (
                <>
                  <rect x={x} y="605" width="14" height="14" rx="3" class={`af-chain-block${i === 3 ? ' af-chain-block--head' : ''}`} />
                  {i < 3 && <line x1={x + 14} y1="612" x2={x + 28} y2="612" class="af-chain-link" />}
                </>
              ))}
            </g>
            <text x="1212" y="616" text-anchor="end" class="af-vault-tag">Ed25519</text>
            {[150, 356, 575, 800, 983, 1156].map((x) => (
              <circle cx={x} cy="578" r="3.5" class="af-vault-mark" />
            ))}
          </g>

          <!-- trace-drop paths (stage bottom -> vault) -->
          <path id="af-t0" class="af-trace-path af-reveal" d="M150,514 L150,578" />
          <path id="af-t1" class="af-trace-path af-reveal" d="M356,476 L356,578" />
          <path id="af-t2" class="af-trace-path af-reveal" d="M575,476 L575,578" />
          <path id="af-tsec" class="af-trace-path af-reveal" d="M800,476 L800,578" />
          <path id="af-t3" class="af-trace-path af-reveal" d="M983,542 L983,578" />
          <path id="af-t4" class="af-trace-path af-reveal" d="M1156,386 L1156,578" />

          <!-- ============ CONTEXT FABRIC: sources row + cross-cutting bar ============ -->
          <g id="af-context" class="af-group" data-reveal>
            {sources.map((s, i) => (
              <g class="af-src">
                <rect x={srcX(i)} y="56" width="180" height="42" rx="11" class="af-card" />
                <g class="af-src-icon" transform={`translate(${srcX(i) + 14},66) scale(0.85)`} set:html={icons[s.icon]} />
                <text x={srcX(i) + 46} y="82" class="af-card-label">{s.label}</text>
                <path id={`af-w${i}`} class="af-wire" d={`M${srcCX(i)},98 L${srcCX(i)},126`} />
                <circle cx={srcCX(i)} cy="126" r="2.5" class="af-port" />
              </g>
            ))}
            <!-- the fabric bar: cross-cutting, like the vault below -->
            <rect x="44" y="126" width="1192" height="66" rx="18" class="af-vault af-fabricbar" />
            <line x1="60" y1="127.5" x2="1220" y2="127.5" class="af-sheen" />
            <g class="af-glyph af-glyph--fabric" transform="translate(66,154)" set:html={glyphs.dot} />
            <text x="94" y="166" class="af-vault-label">{d.fabric}</text>
            <text x="1212" y="163" text-anchor="end" class="af-vault-tag">{d.fabricTag}</text>
          </g>

          <!-- ============ PREFLIGHT RAIL (fabric -> agent, once) ============ -->
          <g id="af-preflight" class="af-group" data-reveal>
            <path id="af-prerail" class="af-rail-pre" d="M64,192 L64,332 Q64,350 92,350" />
            <path class="af-streak" pathLength="100" d="M64,192 L64,332 Q64,350 92,350" style="animation-duration:2.6s" />
            <text x="84" y="252" class="af-rail-label">{d.preflight[0]}</text>
            <text x="84" y="268" class="af-rail-label">{d.preflight[1]}</text>
          </g>

          <!-- ============ ACTIVE CONTEXT LOOP (fabric <-> agent, continuous) ============ -->
          <g id="af-loop" class="af-group" data-reveal>
            <path id="af-answer" class="af-loop-path" d="M160,192 C 168,220 168,254 161,293" />
            <path id="af-query" class="af-loop-path" d="M177,295 C 186,262 186,220 182,192" />
            <path class="af-streak" pathLength="100" d="M160,192 C 168,220 168,254 161,293" style="animation-duration:1.8s" />
            <path class="af-streak" pathLength="100" d="M177,295 C 186,262 186,220 182,192" style="animation-duration:1.8s;animation-delay:-0.9s" />
            <text x="208" y="252" class="af-loop-label">{d.activeContext[0]}</text>
            <text x="208" y="270" class="af-loop-label">{d.activeContext[1]}</text>
          </g>

          <!-- ============ CODING AGENT (always present hub) ============ -->
          <g id="af-agent" class="af-group af-group--base af-reveal">
            <circle cx="150" cy="350" r="58" class="af-agent-ring" />
            <circle cx="150" cy="350" r="51" class="af-agent-ticks" />
            <circle cx="150" cy="350" r="44" class="af-agent-core" />
            <text x="150" y="354" text-anchor="middle" class="af-agent-label">{d.agent[0]}</text>
            <text x="150" y="374" text-anchor="middle" class="af-agent-label">{d.agent[1]}</text>
            <!-- the agent runs contained: Visdom Sandbox tag -->
            <rect x="116" y="416" width="68" height="32" rx="10" class="af-sandbox-tag" />
            <text x="150" y="429" text-anchor="middle" class="af-sandbox-label">{d.sandbox[0]}</text>
            <text x="150" y="441" text-anchor="middle" class="af-sandbox-label">{d.sandbox[1]}</text>
            <!-- the coding agents that plug in here: Cursor, Claude, Codex (official brand marks, simple-icons CC0, 24x24 fitted into the 28x28 chip with 4px padding) -->
            <g class="af-agent-brands" transform="translate(0,460)">
              <text x="150" y="9" text-anchor="middle" class="af-brands-label">{d.runsYourAgent}</text>
              <g class="af-brand" transform="translate(106,18)">
                <title>Cursor</title>
                <rect x="0" y="0" width="28" height="28" rx="8" class="af-brand-chip" />
                <!-- Cursor: official brand mark -->
                <g transform="translate(4,4) scale(0.8333)">
                  <path class="af-brand-mark" d="M11.503.131 1.891 5.678a.84.84 0 0 0-.42.726v11.188c0 .3.162.575.42.724l9.609 5.55a1 1 0 0 0 .998 0l9.61-5.55a.84.84 0 0 0 .42-.724V6.404a.84.84 0 0 0-.42-.726L12.497.131a1.01 1.01 0 0 0-.996 0M2.657 6.338h18.55c.263 0 .43.287.297.515L12.23 22.918c-.062.107-.229.064-.229-.06V12.335a.59.59 0 0 0-.295-.51l-9.11-5.257c-.109-.063-.064-.23.061-.23" />
                </g>
              </g>
              <g class="af-brand" transform="translate(136,18)">
                <title>Claude</title>
                <rect x="0" y="0" width="28" height="28" rx="8" class="af-brand-chip" />
                <!-- Claude: official Anthropic Claude mark -->
                <g transform="translate(4,4) scale(0.8333)">
                  <path class="af-brand-mark" d="m4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z" />
                </g>
              </g>
              <g class="af-brand" transform="translate(166,18)">
                <title>Codex</title>
                <rect x="0" y="0" width="28" height="28" rx="8" class="af-brand-chip" />
                <!-- Codex: OpenAI blossom mark -->
                <g transform="translate(4,4) scale(0.8333)">
                  <path class="af-brand-mark" d="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.2599 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7475-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7948.7948 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.5125 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7712.7712 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3408 7.8956a4.485 4.485 0 0 1 2.3655-1.9728V11.6a.7664.7664 0 0 0 .3879.6765l5.8144 3.3543-2.0201 1.1685a.0757.0757 0 0 1-.071 0l-4.8303-2.7865A4.504 4.504 0 0 1 2.3408 7.872zm16.5963 3.8558L13.1038 8.364 15.1192 7.2a.0757.0757 0 0 1 .071 0l4.8303 2.7913a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6772a.79.79 0 0 0-.407-.667zm2.0107-3.0231l-.142-.0852-4.7735-2.7818a.7759.7759 0 0 0-.7854 0L9.409 9.2297V6.8974a.0662.0662 0 0 1 .0284-.0615l4.8303-2.7866a4.4992 4.4992 0 0 1 6.6802 4.66zM8.3065 12.863l-2.02-1.1638a.0804.0804 0 0 1-.038-.0567V6.0742a4.4992 4.4992 0 0 1 7.3757-3.4537l-.142.0805L8.704 5.459a.7948.7948 0 0 0-.3927.6813zm1.0976-2.3654l2.602-1.4998 2.6069 1.4998v2.9994l-2.5974 1.4997-2.6067-1.4997Z" />
                </g>
              </g>
            </g>
          </g>

          <!-- pipeline connectors (the main spine) -->
          <g id="af-c1g" class="af-reveal">
            <path id="af-c1" class="af-pipe" d="M212,332 L272,332" />
            <path class="af-streak af-streak--pipe" pathLength="100" d="M212,332 L272,332" style="animation-duration:2.4s" />
          </g>
          <g id="af-c2g" class="af-reveal">
            <path id="af-c2" class="af-pipe" d="M440,332 L474,332" />
            <path class="af-streak af-streak--pipe" pathLength="100" d="M440,332 L474,332" style="animation-duration:2.4s;animation-delay:0.5s" />
          </g>
          <g id="af-c3g" class="af-reveal">
            <path id="af-c3" class="af-pipe" d="M676,332 L710,332" />
            <path class="af-streak af-streak--pipe" pathLength="100" d="M676,332 L710,332" style="animation-duration:2.4s;animation-delay:1.0s" />
          </g>
          <g id="af-c4g" class="af-reveal">
            <path id="af-c4" class="af-pipe" d="M890,332 L924,332" />
            <path class="af-streak af-streak--pipe" pathLength="100" d="M890,332 L924,332" style="animation-duration:2.4s;animation-delay:1.5s" />
          </g>
          <g id="af-c5g" class="af-reveal">
            <path id="af-c5" class="af-pipe" d="M1042,332 L1076,332" />
            <path class="af-streak af-streak--pipe" pathLength="100" d="M1042,332 L1076,332" style="animation-duration:2.4s;animation-delay:2.0s" />
          </g>

          <!-- ============ TESTING ============ -->
          <g id="af-testing" class="af-group af-module" data-reveal>
            <rect x="272" y="264" width="168" height="206" rx="16" class="af-panel" />
            <line x1="288" y1="265.5" x2="424" y2="265.5" class="af-sheen" />
            <rect x="278" y="270" width="156" height="26" rx="8" class="af-mhead" />
            <g class="af-glyph" transform="translate(290,278)" set:html={glyphs.diamond} />
            <text x="310" y="288" class="af-mhead-label">{d.testing}</text>
            {testLayers.map((t, i) => (
              <g class="af-test-row">
                <rect x="280" y={testY(i)} width="152" height="34" rx="8" class="af-chip" />
                <text x="356" y={testY(i) + 22} text-anchor="middle" class="af-chip-label">{t}</text>
              </g>
            ))}
          </g>

          <!-- the pull request: a soft envelope, review and triage happen inside it.
               top edge sits just under the orchestrator band; label moved to the
               bottom-right so it does not collide with the band above -->
          <g id="af-pr-env" class="af-reveal">
            <rect x="462" y="258" width="588" height="226" rx="20" class="af-prenv" />
            <g class="af-prenv-icon" transform="translate(834,470) scale(0.5)" set:html={icons.pr} />
            <text x="964" y="480" text-anchor="end" class="af-prenv-label">{d.pullRequest}</text>
          </g>

          <!-- ============ CODE REVIEW (deepening) ============ -->
          <g id="af-review" class="af-group af-module" data-reveal>
            <rect x="474" y="264" width="202" height="206" rx="16" class="af-panel" />
            <line x1="490" y1="265.5" x2="660" y2="265.5" class="af-sheen" />
            <rect x="480" y="270" width="190" height="26" rx="8" class="af-mhead" />
            <g class="af-glyph" transform="translate(492,278)" set:html={glyphs.square} />
            <text x="512" y="288" class="af-mhead-label">{d.review}</text>
            {reviewLevels.map((r, i) => (
              <g class={`af-review-row af-depth-${i}`}>
                <rect x={revX[i]} y={revY(i)} width={revW[i]} height="34" rx="8" class="af-review-bar" />
                <text x={revX[i] + 13} y={revY(i) + 22} class="af-review-n">{r.n}</text>
                <text x={revX[i] + 36} y={revY(i) + 22} class="af-review-label">{r.label}</text>
              </g>
            ))}
          </g>

          <!-- ============ SECURITY (AppSec on the same PR, powered by Aikido) ============ -->
          <g id="af-security" class="af-group af-module" data-reveal>
            <rect x="710" y="264" width="180" height="206" rx="16" class="af-panel" />
            <line x1="726" y1="265.5" x2="874" y2="265.5" class="af-sheen" />
            <rect x="716" y="270" width="168" height="26" rx="8" class="af-mhead" />
            <g class="af-glyph" transform="translate(728,278)" set:html={glyphs.square} />
            <text x="748" y="288" class="af-mhead-label">{d.security}</text>
            {securityLayers.map((s, i) => (
              <g class="af-sec-row">
                <rect x="722" y={testY(i)} width="156" height="34" rx="8" class="af-chip" />
                <text x="800" y={testY(i) + 22} text-anchor="middle" class="af-chip-label">{s}</text>
              </g>
            ))}
            <g class="af-sec-row">
              <text x="800" y="433" text-anchor="middle" class="af-brands-label">{d.poweredBy}</text>
              <g class="af-brand">
                <title>Aikido</title>
                <rect x="760" y="438" width="28" height="28" rx="8" class="af-brand-chip" />
                <!-- Aikido: official brand mark (aikido.dev) -->
                <g transform="translate(765.2,442) scale(1.1)">
                  <path class="af-brand-mark" d="M15.9961 0H0V5.65188H15.9961V0Z" />
                  <path class="af-brand-mark" d="M0 10.953C4.5507 6.83365 11.4453 6.83364 15.9961 10.953V17.9968L15.9929 18L7.99803 9.88536L0.00313606 18L0 17.9968V10.953Z" />
                </g>
              </g>
              <text x="796" y="460" class="af-chip-label">Aikido</text>
            </g>
          </g>

          <!-- ============ TRIAGE (its own block: it owns the gating) ============ -->
          <g id="af-triage" class="af-group af-module" data-reveal>
            <rect x="924" y="264" width="118" height="104" rx="16" class="af-panel" />
            <line x1="940" y1="265.5" x2="1026" y2="265.5" class="af-sheen" />
            <rect x="930" y="270" width="106" height="26" rx="8" class="af-mhead" />
            
            <text x="983" y="288" text-anchor="middle" class="af-mhead-label">{d.triage}</text>

            <rect x="927" y="311" width="112" height="42" rx="10" class="af-pr" />
            <text x="983" y="337" text-anchor="middle" class="af-pr-label">{d.riskGate}</text>

            <!-- fork below the panel: trivial loops back, risk stops at the human gate.
                 the risk drop, the gate and its trace share one axis: PR -> gate -> vault -->
            <path class="af-branch af-branch--risk" d="M983,370 L983,484" marker-end="url(#af-arrow-amber)" />
            <g class="af-triage-node af-triage-node--green">
              <path id="af-autofix" class="af-autofix-path" d="M963,370 C 963,460 913,518 823,518 L320,518 C 252,518 206,462 194,389" />
              <path class="af-streak af-streak--soft" pathLength="100" d="M963,370 C 963,460 913,518 823,518 L320,518 C 252,518 206,462 194,389" style="animation-duration:3.6s" />
              <text x="530" y="508" text-anchor="middle" class="af-autofix-label">{d.autofix}</text>
            </g>
            <g class="af-triage-node af-triage-node--risk">
              <rect x="913" y="490" width="152" height="46" rx="10" class="af-card af-card--risk" />
              <text x="953" y="510" class="af-card-label af-card-label--risk">{d.highRisk}</text>
              <text x="953" y="527" class="af-card-sub">{d.humanApproval}</text>
              <g class="af-human" transform="translate(933,508)">
                <circle cx="0" cy="-4" r="5" class="af-human-mark" />
                <path d="M-8,10 a8,9 0 0 1 16,0" class="af-human-mark" />
              </g>
              <!-- approved: the human waves it through, orthogonal elbow up to production.
                   revealed with the ship stage so the arrow never points at empty space -->
              <g id="af-approved">
                <path class="af-branch af-branch--risk" d="M1065,513 L1102,513 Q1118,513 1118,497 L1118,388" marker-end="url(#af-arrow-amber)" />
                <text x="1069" y="529" class="af-approved-label">{d.approved}</text>
              </g>
            </g>
          </g>

          <!-- ============ SHIP TO PRODUCTION (the joyful finale, end of the line) ============ -->
          <g id="af-ship" class="af-group" data-reveal>
            <rect x="1076" y="284" width="160" height="96" rx="16" class="af-ship-box" />
            <line x1="1092" y1="285.5" x2="1220" y2="285.5" class="af-sheen" />
            <g class="af-ship-icon" transform="translate(1094,319) scale(1.15)" set:html={icons.rocket} />
            <text x="1132" y="338" class="af-ship-label">{d.production}</text>
            <!-- passed seal -->
            <circle cx="1228" cy="292" r="11" class="af-seal" />
            <g class="af-seal-check" transform="translate(1220,284) scale(0.66)" set:html={icons.check} />
            <!-- confetti: the only multi-colour moment in the whole diagram -->
            <g class="af-confetti" aria-hidden="true">
              {[
                { x: 1084, y: 270, c: 1, d: 0 },
                { x: 1108, y: 264, c: 2, d: 0.3 },
                { x: 1132, y: 268, c: 3, d: 0.6 },
                { x: 1158, y: 262, c: 4, d: 0.15 },
                { x: 1182, y: 269, c: 1, d: 0.45 },
                { x: 1068, y: 288, c: 3, d: 0.7 },
                { x: 1242, y: 316, c: 2, d: 0.2 },
                { x: 1096, y: 256, c: 4, d: 0.55 },
                { x: 1166, y: 252, c: 2, d: 0.85 },
                { x: 1226, y: 266, c: 1, d: 1.0 },
                { x: 1144, y: 274, c: 1, d: 1.2 },
                { x: 1204, y: 270, c: 3, d: 0.95 },
              ].map((p) => (
                <rect x={p.x} y={p.y} width="6" height="6" rx="1.8" class={`af-conf af-conf--${p.c}`} style={`animation-delay:${p.d}s`} />
              ))}
            </g>
          </g>

          <!-- ============ AMBIENT PARTICLES (grouped per reveal stage) ============ -->
          <g class="af-particles" aria-hidden="true">
            {particleStages.map((stage) => (
              <g class="af-pgroup" data-stage={stage}>
                {particles.filter((p) => p.stage === stage).map((p) => (
                  <circle class={`af-particle af-particle--${p.tone}`} r="3.2" cx="-20" cy="-20"
                    data-path={`#${p.path}`} data-dur={p.dur} data-delay={p.delay} data-pause={p.pause ?? 0} />
                ))}
              </g>
            ))}
          </g>

          <!-- ============ HUD RETICLE (slides between active stages) ============ -->
          <g id="af-reticle" aria-hidden="true">
            <path id="af-ret-tl" class="af-ret-c" d="M0,14 L0,4 Q0,0 4,0 L14,0" />
            <path id="af-ret-tr" class="af-ret-c" d="M0,14 L0,4 Q0,0 4,0 L14,0" />
            <path id="af-ret-bl" class="af-ret-c" d="M0,14 L0,4 Q0,0 4,0 L14,0" />
            <path id="af-ret-br" class="af-ret-c" d="M0,14 L0,4 Q0,0 4,0 L14,0" />
          </g>
        </svg>
      </div>

      <ol class="af-steps" role="list">
        {captions.map((c, i) => (
          <li class={`af-step${i === 0 ? ' is-active' : ''}`} data-step={i}>
            <button type="button" class="af-step-btn" aria-label={fill(t.architecture.stepAria, { n: c.n, t: c.t })}>
              <span class="af-step-head">
                <span class="af-step-n">{c.n}</span>
                <span class="af-step-t">{c.t}</span>
              </span>
            </button>
            <span class="af-step-d">{c.d}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .af { position: relative; padding: 4rem 0 2rem; }
  .af-head { max-width: 48rem; margin-bottom: 2rem; }
  .af-head .section-subtitle { margin-top: 0.75rem; }
  .af-head .section-subtitle a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-emerald);
    transition: color 0.2s ease;
  }
  .af-head .section-subtitle a:hover { color: var(--color-emerald-dark); }

  /* tall track -> sticky viewport for the scrubbed scene (10 steps) */
  .af-track { position: relative; height: 590vh; }
  .af-viewport {
    position: sticky;
    top: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.5rem, 4vh, 3rem);
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem clamp(20px, 4vw, 56px);
  }

  .af-stage { width: 100%; }
  .af-svg { width: 100%; height: auto; overflow: visible; display: block; }

  /*
   * Polish labels run 15 to 30 percent longer than the English this diagram's
   * geometry was laid out for, so they crowd their pills. Step the whole label
   * scale down one notch for that locale.
   *
   * Every af-* label takes its size from a --fs-* token, so redefining the
   * tokens on the svg scales all 32 text nodes together and keeps them in
   * proportion with each other. Doing it per class would drift the moment
   * someone touched one rule. Only the tokens the diagram actually uses are
   * listed. The scroll captions live outside the svg and keep full size.
   *
   * One number to tune: --af-label-scale.
   */
  :global(html[lang='pl']) .af-svg {
    --af-label-scale: 0.9;
    --fs-4xs: calc(0.5625rem * var(--af-label-scale));
    --fs-3xs: calc(0.625rem * var(--af-label-scale));
    --fs-2xs: calc(0.6875rem * var(--af-label-scale));
    --fs-xs: calc(0.75rem * var(--af-label-scale));
    --fs-sm: calc(0.8125rem * var(--af-label-scale));
    --fs-md: calc(0.875rem * var(--af-label-scale));
    --fs-base: calc(0.9375rem * var(--af-label-scale));
    --fs-lg: calc(1rem * var(--af-label-scale));
    --fs-xl: calc(1.0625rem * var(--af-label-scale));
    --fs-3xl: calc(1.25rem * var(--af-label-scale));
  }

  /*
   * The L1-L4 bars are the narrowest text slot in the diagram: 142px between
   * where the label starts and the bar's right edge. "Reguły deterministyczne"
   * needs 142.3px at the scaled --fs-sm, so it would sit flush against the
   * edge. One token step down buys 11px and the 0.9px size difference against
   * the neighbouring chips is not perceptible.
   */
  :global(html[lang='pl']) .af-review-label {
    font-size: var(--fs-xs);
  }

  /* ---- stage reveal (driven by GSAP; everything visible without JS) ---- */
  .js .af-group[data-reveal],
  .js .af-reveal { opacity: 0; }
  .af-group.is-active :is(.af-core, .af-agent-core, .af-panel, .af-vault, .af-orch-box) { filter: drop-shadow(0 0 12px var(--vmm-accent-soft)) drop-shadow(0 0 4px var(--vmm-accent)); }

  /* ---- blueprint substrate ---- */
  /*
   * One accent per module, and the module owns it. Before this, every surface,
   * pipe and border was tinted with the single emerald accent, which made the
   * whole diagram read as one green mass; now the colour only appears in a
   * module's glyph and the few marks that belong to it, and everything
   * structural is neutral. Both themes, because the reference is light and ours
   * defaults to dark.
   */
  .af {
    --af-blue: #2f6feb;
    --af-green: #16a34a;
    --af-olive: #8a9b1f;
    --af-amber: #c2820a;
    --af-red: #c2543d;
    --af-teal: #0d9488;
  }

  :global(.dark) .af {
    --af-blue: #60a5fa;
    --af-green: #34d399;
    --af-olive: #bcd23a;
    --af-amber: #f0b429;
    --af-red: #ef8b73;
    --af-teal: #2dd4bf;
  }

  #af-testing { --af-accent: var(--af-olive); }
  #af-review { --af-accent: var(--af-amber); }
  #af-security { --af-accent: var(--af-red); }

  .af-glyph { fill: var(--af-accent, var(--color-text-muted)); stroke: var(--af-accent, var(--color-text-muted)); }
  .af-glyph--fabric { fill: var(--af-blue); stroke: var(--af-blue); }
  .af-glyph--orch { fill: none; stroke: var(--af-green); }
  .af-glyph--tracing { fill: var(--af-teal); stroke: var(--af-teal); }

  .af-grid-dot { fill: var(--color-text-muted); opacity: 0.12; }
  .af-bp { opacity: 0.35; pointer-events: none; }
  .af-fid path { stroke: var(--color-border); stroke-width: 1; fill: none; opacity: 0.5; }

  /* 1px inner top highlight: gives panels a machined edge */
  .af-sheen { stroke: rgba(255, 255, 255, 0.5); stroke-width: 1; opacity: 0; }
  :global(.dark) .af-sheen { stroke: rgba(255, 255, 255, 0.14); opacity: 1; }

  /* module header chip */
  .af-mhead { fill: transparent; }
  /* concrete-detail footers inside modules */
  /* the agent runs inside Visdom Sandbox */
  .af-sandbox-tag { fill: var(--color-surface-light); stroke: var(--color-border); stroke-width: 1; }
  .af-sandbox-label { fill: var(--color-text-secondary); font: 600 var(--fs-3xs) var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  /* the coding agents that can run inside the sandbox */
  .af-brands-label { fill: var(--color-text-muted); font: 600 var(--fs-4xs) var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .af-brand-chip { fill: var(--color-surface); stroke: var(--color-border); stroke-width: 1.25; }
  .af-brand-mark { fill: var(--color-text); }
  .af-mhead-label { fill: var(--color-text); font: 600 var(--fs-xs) var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; }

  /* light streaks: a glowing segment travels the path (pathLength=100) */
  .af-streak {
    fill: none;
    stroke: color-mix(in oklab, var(--color-text) 45%, transparent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 14 86;
    animation: af-streak 2.4s linear infinite;
    filter: drop-shadow(0 0 3px var(--vmm-accent));
    pointer-events: none;
  }
  .af-streak--pipe { stroke-width: 3; stroke-dasharray: 22 78; }
  .af-streak--soft { stroke-width: 2; stroke-dasharray: 8 92; opacity: 0.9; }
  @keyframes af-streak { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }

  /* HUD reticle corners */
  .af-ret-c { fill: none; stroke: var(--vmm-accent); stroke-width: 2; opacity: 0; }

  /* hover microinteractions */
  .af-src { transition: transform 0.25s ease; }
  .af-src:hover { transform: translateX(4px); }
  .af-module .af-panel { transition: stroke 0.25s ease; }
  .af-module:hover .af-panel { stroke: color-mix(in oklab, var(--vmm-accent) 45%, var(--color-border)); }

  /* ---- nodes / cards ---- */
  .af-card { fill: var(--card); stroke: var(--color-border); stroke-width: 1.25; }
  .af-card--green { stroke: var(--vmm-accent); }
  .af-card--risk { stroke: var(--color-amber); }
  .af-card-label { fill: var(--color-text); font: 600 var(--fs-sm) var(--font-body); }
  .af-card-label--green { fill: var(--color-emerald-dark); font-weight: 700; font-size: var(--fs-base); }
  .af-card-label--risk { fill: var(--color-amber); font-weight: 700; font-size: var(--fs-base); }
  .af-card-sub { fill: var(--color-text-secondary); font: 500 var(--fs-sm) var(--font-body); }
  .af-src-icon { fill: none; stroke: var(--color-text-muted); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  /* the fabric bar mirrors the vault but earns the accent: it is the spine of the thesis */
  .af-fabricbar { stroke: var(--color-border); }

  /* the orchestrator enclosure: the engine room wrapping preflight, the agent, testing,
     review and triage. Soft accent fill so the blueprint shows through; everything inside
     renders on top. Production sits outside it. */
  .af-orch-box {
    fill: color-mix(in oklab, var(--color-text-muted) 4%, transparent);
    stroke: var(--color-border);
    stroke-width: 1.25;
  }
  :global(.dark) .af-orch-box { fill: color-mix(in oklab, var(--color-text-muted) 8%, transparent); }
  .af-orch-legend { fill: var(--card); stroke: var(--color-border); stroke-width: 1.25; }
  .af-orch-label { fill: var(--color-text); font: 700 var(--fs-lg) var(--font-heading); }
  .af-orch-sub { fill: var(--color-text-muted); font: 600 var(--fs-4xs) var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }

  /* the pull request envelope: a soft mist around review + triage */
  .af-prenv {
    fill: transparent;
    stroke: color-mix(in oklab, var(--color-text-muted) 40%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 4;
  }
  :global(.dark) .af-prenv { fill: color-mix(in oklab, var(--color-text-muted) 6%, transparent); }
  .af-prenv-icon { fill: none; stroke: var(--color-text-muted); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .af-prenv-label { fill: var(--color-text-muted); font: 600 var(--fs-xs) var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; }

  .af-wire, .af-trace-path {
    fill: none;
    stroke: color-mix(in oklab, var(--color-text-muted) 45%, transparent);
    stroke-width: 1.25;
  }
  .af-trace-path { stroke-dasharray: 3 7; opacity: 0.6; }
  .af-port { fill: var(--color-text-muted); opacity: 0.55; }

  /* the main spine reads as THE flow: solid, accent, thicker */
  .af-pipe { fill: none; stroke: color-mix(in oklab, var(--color-text-muted) 55%, transparent); stroke-width: 1.5; }

  .af-rail-pre { fill: none; stroke: var(--af-blue); stroke-width: 1.5; stroke-dasharray: 5 5; opacity: 0.85; }
  .af-arrowhead--amber { fill: var(--color-amber); }
  .af-rail-label { fill: var(--af-blue); font: 600 var(--fs-md) var(--font-body); }

  /* dashes drift along the path direction: constant, legible direction cue */
  .af-loop-path { fill: none; stroke: var(--af-blue); stroke-width: 1.5; stroke-dasharray: 5 5; opacity: 0.85; }
  .af-loop-label { fill: var(--af-blue); font: 600 var(--fs-md) var(--font-body); }

  .af-agent-ring { fill: none; stroke: var(--color-border); stroke-width: 1.5; opacity: 0.9; transform-box: fill-box; transform-origin: center; animation: af-ring 2.8s ease-out infinite; }
  /* dial: slowly rotating tick ring around the agent */
  .af-agent-ticks {
    fill: none;
    stroke: color-mix(in oklab, var(--color-text-muted) 40%, transparent);
    stroke-width: 3;
    stroke-dasharray: 2 9;
    opacity: 0.55;
    transform-box: fill-box;
    transform-origin: center;
    animation: af-rotate 40s linear infinite;
  }
  .af-agent-core { fill: var(--color-surface-light); stroke: var(--color-border); stroke-width: 1.25; }
  .af-agent-label { fill: var(--color-text); font: 700 var(--fs-xl) var(--font-heading); }
  @keyframes af-rotate { to { transform: rotate(360deg); } }

  .af-panel { fill: color-mix(in oklab, var(--color-text-muted) 3%, transparent); stroke: var(--color-border); stroke-width: 1.25; }
  .af-chip { fill: var(--card); stroke: var(--color-border); stroke-width: 1.25; }
  .af-chip-label { fill: var(--color-text); font: 600 var(--fs-md) var(--font-body); }

  /* depth ramp: fill saturation grows, only L4 earns the accent border */
  .af-review-bar { fill: var(--card); stroke: var(--color-border); stroke-width: 1.25; animation: af-gate 3.8s ease-in-out infinite; }
  .af-depth-0 .af-review-bar { animation-delay: 0s; }
  .af-depth-1 .af-review-bar { animation-delay: 0.45s; }
  .af-depth-2 .af-review-bar { animation-delay: 0.9s; }
  .af-depth-3 .af-review-bar { animation-delay: 1.35s; }

  /* gate scan: a soft highlight sweeps L1 to L4, the analysis deepening on loop */
  @keyframes af-gate {
    0%, 24%, 100% { filter: none; }
    9% { filter: brightness(1.35) drop-shadow(0 0 5px var(--vmm-accent-soft)); }
  }
  .af-review-n { fill: var(--af-accent); font: 700 var(--fs-xs) var(--font-mono); }
  .af-review-label { fill: var(--color-text); font: 600 var(--fs-sm) var(--font-body); }
  .af-depth-label { fill: var(--color-text-secondary); font: 600 var(--fs-sm) var(--font-body); }

  .af-pr { fill: var(--card); stroke: var(--color-border); stroke-width: 1.25; }
  .af-pr-label { fill: var(--color-text); font: 700 var(--fs-base) var(--font-body); }
  .af-branch { fill: none; stroke-width: 2; }
  .af-branch--green { stroke: var(--vmm-accent); }
  .af-branch--risk { stroke: var(--color-amber); }
  .af-human-mark { fill: none; stroke: var(--color-amber); stroke-width: 1.6; }
  .af-approved-label { fill: var(--af-green); font: 600 var(--fs-2xs) var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; }

  .af-autofix-path { fill: none; stroke: var(--af-green); stroke-width: 1.25; stroke-dasharray: 4 5; opacity: 0.8; }
  .af-autofix-label { fill: var(--af-green); font: 600 var(--fs-sm) var(--font-body); }

  /* ---- vault ---- */
  .af-vault {
    fill: var(--card);
    stroke: var(--color-border);
    stroke-width: 1.25;
  }
  .af-vault-rule { stroke: var(--color-border); stroke-width: 1; opacity: 0.7; }
  .af-vault-label { fill: var(--color-text); font: 700 var(--fs-3xl) var(--font-heading); }
  .af-vault-tag { fill: var(--color-text-muted); font: 600 var(--fs-2xs) var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .af-vault-mark { fill: var(--color-text-muted); opacity: 0.5; }
  .af-chain-block { fill: var(--vmm-accent-soft); stroke: color-mix(in oklab, var(--vmm-accent) 45%, var(--color-border)); stroke-width: 1.25; }
  .af-chain-block--head { fill: color-mix(in oklab, var(--vmm-accent) 30%, var(--card)); stroke: var(--vmm-accent); }
  .af-chain-link { stroke: color-mix(in oklab, var(--vmm-accent) 40%, var(--color-border)); stroke-width: 1.5; stroke-dasharray: 2 3; }

  /* ---- ship to production: the joyful finale, dressed like the other modules ---- */
  .af-ship-box { fill: var(--card); stroke: var(--af-green); stroke-width: 1.25; }
  .af-ship-icon { fill: none; stroke: var(--vmm-accent); stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .af-ship-label { fill: var(--color-text); font: 700 var(--fs-xl) var(--font-heading); }
  .af-ship-sub { fill: var(--vmm-accent); font: 600 var(--fs-2xs) var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .af-seal { fill: var(--card); stroke: var(--vmm-accent); stroke-width: 2; }
  .af-seal-check { fill: none; stroke: var(--vmm-accent); stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; }
  .af-group.is-active .af-ship-box { filter: drop-shadow(0 0 14px var(--vmm-accent-soft)) drop-shadow(0 0 5px var(--vmm-accent)); }

  .af-conf { transform-box: fill-box; transform-origin: center; animation: af-confetti 2.6s ease-out infinite; opacity: 0; }
  .af-conf--1 { fill: var(--vmm-accent); }
  .af-conf--2 { fill: var(--color-amber); }
  .af-conf--3 { fill: var(--color-blue); }
  .af-conf--4 { fill: var(--color-purple); }
  @keyframes af-confetti {
    0% { opacity: 0; transform: translateY(8px) rotate(0deg) scale(0.5); }
    18% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-22px) rotate(170deg) scale(1.05); }
  }

  /* dark bg is near-black: the vault needs a stronger tint to read as a layer */
  :global(.dark) .af-vault {
    fill: color-mix(in oklab, var(--vmm-accent) 10%, var(--color-surface));
    stroke: color-mix(in oklab, var(--vmm-accent) 45%, var(--color-border));
  }

  /* ---- particles ---- */
  .af-particle { fill: var(--vmm-accent); }
  .af-particle--green { fill: var(--vmm-accent); }
  .af-particle--risk { fill: var(--color-amber); }
  .af-particle--trace { fill: var(--color-text-muted); r: 2.4; }
  .af-particle--ctx { fill: var(--vmm-accent-2); }

  /* ---- captions: bottom stepper, shared crossfading description ---- */
  .af-steps {
    list-style: none;
    width: 100%;
    max-width: 1260px;
    margin: 0 auto;
    padding: 0 0 4.2em;
    position: relative;
    display: grid;
    grid-template-columns: repeat(10, 1fr);
  }
  .af-step {
    padding: 0.9rem 16px 1.1rem;
    border-top: 2px solid var(--color-border);
    opacity: 0.5;
    transition: opacity 0.3s ease, border-color 0.3s ease;
  }
  .af-step.is-active { opacity: 1; border-top-color: var(--vmm-accent); }
  .af-step-btn {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .af-step:hover { opacity: 1; }
  .af-step-head { display: flex; flex-direction: column; gap: 3px; }
  .af-step-n { font: 700 var(--fs-xs) var(--font-mono); color: var(--vmm-accent); }
  .af-step-t { font: 600 var(--fs-base) var(--font-heading); color: var(--color-text); line-height: 1.25; }

  /* description: all share one area at the bottom of the row, only active shows */
  .af-step-d {
    position: absolute;
    left: 0;
    bottom: 0.3em;
    width: min(64ch, 100%);
    font: 400 clamp(var(--fs-lg), 1.35vw, 1.2rem) var(--font-body);
    line-height: 1.55;
    color: var(--color-text-secondary);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    pointer-events: none;
  }
  .af-step.is-active .af-step-d { opacity: 1; transform: none; }

  @keyframes af-pulse { 0%, 100% { opacity: 1; r: 3.5; } 50% { opacity: 0.4; r: 6; } }
  @keyframes af-ring { 0% { opacity: 0.5; transform: scale(1); } 100% { opacity: 0; transform: scale(1.18); } }

  /* ---- responsive: no pin, stack captions, static reveal ---- */
  @media (max-width: 900px) {
    .af-track { height: auto; }
    .af-viewport { position: static; min-height: 0; gap: 1.5rem; }
    .js .af-group[data-reveal],
    .js .af-reveal { opacity: 1; }

    /* keep the wide diagram legible: swipe horizontally */
    .af-stage { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .af-svg { min-width: 960px; }

    .af-steps { grid-template-columns: 1fr; padding-bottom: 0; }
    .af-step { opacity: 1; }
    .af-step-d { position: static; opacity: 1; transform: none; width: auto; margin-top: 0.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .js .af-group[data-reveal],
    .js .af-reveal { opacity: 1; }
    .af-core-pulse, .af-agent-ring, .af-agent-ticks, .af-streak, .af-conf, .af-review-bar { animation: none; }
    .af-streak, .af-particle, .af-confetti, #af-reticle { display: none; }
    .af-step { opacity: 1; }
    /* no scrub: stack descriptions so they do not overlap */
    .af-steps { padding-bottom: 0; }
    .af-step-d { position: static; opacity: 1; transform: none; width: auto; margin-top: 0.5rem; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { MotionPathPlugin } from 'gsap/MotionPathPlugin';

  gsap.registerPlugin(ScrollTrigger, MotionPathPlugin);

  const root = document.querySelector('.af');
  if (root) {
    document.documentElement.classList.add('js');

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const compact = window.matchMedia('(max-width: 900px)').matches;

    const groups = ['af-context', 'af-orchestrator', 'af-preflight', 'af-loop', 'af-testing', 'af-review', 'af-security', 'af-triage', 'af-tracing', 'af-ship']
      .map((id) => document.getElementById(id));
    const captions = Array.from(root.querySelectorAll('.af-step'));

    // elements revealed at each scroll step (stage group + its connectors/traces)
    const reveal = [
      ['#af-context'],
      ['#af-orchestrator'],
      ['#af-preflight', '#af-agent'],
      ['#af-loop'],
      ['#af-testing', '#af-c1g'],
      ['#af-pr-env', '#af-review', '#af-c2g'],
      ['#af-security', '#af-c3g'],
      ['#af-triage', '#af-c4g'],
      ['#af-tracing', '#af-t0', '#af-t1', '#af-t2', '#af-tsec', '#af-t3'],
      ['#af-ship', '#af-c5g', '#af-t4', '#af-approved'],
    ].map((sels) => sels.flatMap((s) => Array.from(document.querySelectorAll(s))));
    const allTargets = reveal.flat();

    // HUD reticle target boxes per stage (viewBox coordinates)
    const RETICLE = [
      { x: 36, y: 118, w: 1208, h: 82 },
      { x: 38, y: 214, w: 1028, h: 356 },
      { x: 44, y: 216, w: 146, h: 92 },
      { x: 162, y: 186, w: 172, h: 128 },
      { x: 264, y: 256, w: 184, h: 222 },
      { x: 466, y: 256, w: 218, h: 222 },
      { x: 702, y: 256, w: 196, h: 222 },
      { x: 905, y: 256, w: 156, h: 290 },
      { x: 36, y: 570, w: 1208, h: 84 },
      { x: 1068, y: 276, w: 176, h: 112 },
    ];
    const corners = {
      tl: document.getElementById('af-ret-tl'),
      tr: document.getElementById('af-ret-tr'),
      bl: document.getElementById('af-ret-bl'),
      br: document.getElementById('af-ret-br'),
    };
    const moveReticle = (idx, instant = false) => {
      const r = RETICLE[idx];
      if (!r || !corners.tl) return;
      const pos = {
        tl: { x: r.x, y: r.y, scaleX: 1, scaleY: 1 },
        tr: { x: r.x + r.w, y: r.y, scaleX: -1, scaleY: 1 },
        bl: { x: r.x, y: r.y + r.h, scaleX: 1, scaleY: -1 },
        br: { x: r.x + r.w, y: r.y + r.h, scaleX: -1, scaleY: -1 },
      };
      Object.entries(pos).forEach(([k, p]) => {
        gsap.to(corners[k], { ...p, opacity: 1, duration: instant ? 0 : 0.55, ease: 'power3.out' });
      });
    };

    // ---- ambient particle motion (always on unless reduced motion) ----
    // pause > 0: discrete packet (fade in, travel once, fade out, wait, repeat)
    // pause = 0: continuous orbit (the active-context loop)
    if (!reduce) {
      root.querySelectorAll('.af-particle').forEach((p) => {
        const sel = p.getAttribute('data-path');
        const path = sel && document.querySelector(sel);
        if (!path) return;
        const dur = parseFloat(p.getAttribute('data-dur') || '2');
        const delay = parseFloat(p.getAttribute('data-delay') || '0');
        const pause = parseFloat(p.getAttribute('data-pause') || '0');
        const motion = { motionPath: { path, align: path, alignOrigin: [0.5, 0.5] } };
        if (pause > 0) {
          const t = gsap.timeline({ repeat: -1, repeatDelay: pause, delay });
          t.fromTo(p, { opacity: 0 }, { opacity: 1, duration: 0.2, ease: 'none' }, 0)
            .to(p, { ...motion, duration: dur, ease: 'power1.inOut' }, 0)
            .to(p, { opacity: 0, duration: 0.25, ease: 'none' }, dur - 0.25);
        } else {
          gsap.to(p, { ...motion, duration: dur, delay, repeat: -1, ease: 'none' });
        }
      });
    }

    let lastIdx = -1;
    const setActive = (idx) => {
      if (idx === lastIdx) return;
      lastIdx = idx;
      groups.forEach((g, i) => g && g.classList.toggle('is-active', i === idx));
      captions.forEach((c, i) => c.classList.toggle('is-active', i === idx));
      moveReticle(idx);
    };

    if (reduce || compact) {
      // static: everything revealed, no scrub, no reticle
      gsap.set(allTargets, { opacity: 1, y: 0 });
      gsap.set('.af-pgroup', { opacity: 1 });
      gsap.set('#af-reticle', { display: 'none' });
      captions.forEach((c) => c.classList.add('is-active'));
      // static mode has no scrub to jump to, take the inert buttons out of the tab order
      root.querySelectorAll('.af-step-btn').forEach((b) => b.setAttribute('tabindex', '-1'));
    } else {
      const steps = reveal.length;
      // unveil one cluster per scroll step. stage one is on stage from the
      // first frame: an empty canvas under an active step 01 reads as broken.
      // particles are gated via their stage GROUP, so the per-dot ambient
      // tweens never fight the scroll tween over the same property.
      gsap.set(allTargets, { opacity: 0, y: 14 });
      gsap.set(reveal[0], { opacity: 1, y: 0 });
      gsap.set('.af-pgroup', { opacity: 0 });
      gsap.set('.af-pgroup[data-stage="0"]', { opacity: 1 });
      // gates cascade in one by one inside their stage
      const cascades = {
        4: '#af-testing .af-test-row',
        5: '#af-review .af-review-row',
        6: '#af-security .af-sec-row',
        7: '#af-triage .af-triage-node',
      };
      Object.values(cascades).forEach((sel) => gsap.set(sel, { opacity: 0, y: 10 }));

      // the HUD frame stays hidden until the reader actually reaches the
      // pinned diagram, a highlight before any scrolling reads as noise
      gsap.set('#af-reticle', { opacity: 0 });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '.af-track',
          start: 'top top',
          end: 'bottom bottom',
          scrub: 0.6,
          onUpdate: (self) => setActive(Math.min(steps - 1, Math.floor(self.progress * steps))),
          onToggle: (self) => gsap.to('#af-reticle', { opacity: self.isActive ? 1 : 0, duration: 0.4 }),
        },
      });

      reveal.forEach((els, i) => {
        if (i === 0) return; // already visible at the start
        tl.to(els, { opacity: 1, y: 0, duration: 0.7, ease: 'power2.out' }, i);
        if (cascades[i]) {
          tl.to(cascades[i], { opacity: 1, y: 0, duration: 0.35, stagger: 0.18, ease: 'power2.out' }, i + 0.12);
        }
        const grp = document.querySelector(`.af-pgroup[data-stage="${i}"]`);
        if (grp) tl.to(grp, { opacity: 1, duration: 0.5 }, i + 0.25);
      });
      // tail room so the last stage fully lands before the scroll ends
      tl.to({}, { duration: 0.8 });

      // clicking a step scrolls the page to that stage of the scrub
      captions.forEach((c, i) => {
        const btn = c.querySelector('.af-step-btn');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const st = tl.scrollTrigger;
          const target = st.start + (st.end - st.start) * ((i + 0.5) / steps);
          window.scrollTo({ top: target, behavior: 'smooth' });
        });
      });

      setActive(0);
      moveReticle(0, true);
      // page loaded mid-track (refresh while inside the section): show the frame right away
      if (tl.scrollTrigger && tl.scrollTrigger.isActive) gsap.set('#af-reticle', { opacity: 1 });
    }

    ScrollTrigger.refresh();
  }
</script>
