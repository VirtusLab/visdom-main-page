---
/**
 * Two blocks lifted from the other Visdom property: who built this, and the
 * stack we are embedded in.
 *
 * The partner logos come in two flavours. The monochrome wordmarks ship an
 * -on-dark twin because they are drawn in near-black and vanish on our dark
 * theme; the full-colour product icons work on both and ship once. Swapped with
 * :global(.dark), which is this project's convention, rather than a Tailwind
 * dark: variant, since no dark custom-variant is configured here.
 */
import { useI18n } from '../i18n';

const { t } = useI18n(Astro);
const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

type Partner = {
  name: string;
  file: string;
  /** true when a separate light-ink version exists for the dark theme. */
  onDark?: boolean;
  /** Rendered height in px. Wordmarks 24, icons 32, as on the source page. */
  h: number;
};

const partners: Partner[] = [
  { name: 'IntelliJ IDEA', file: 'logo-intellij-idea', h: 32 },
  { name: 'PyCharm', file: 'logo-pycharm', h: 32 },
  { name: 'CLion', file: 'logo-clion', h: 32 },
  { name: 'Visual Studio Code', file: 'logo-vscode', h: 32 },
  { name: 'Visual Studio', file: 'logo-visual-studio', h: 32 },
  { name: 'Claude', file: 'logo-claude', h: 32 },
  { name: 'JetBrains', file: 'logo-jetbrains', onDark: true, h: 24 },
  { name: 'Cursor', file: 'logo-cursor', onDark: true, h: 24 },
  { name: 'Sourcegraph', file: 'logo-sourcegraph', onDark: true, h: 24 },
  { name: 'Databricks', file: 'logo-databricks', onDark: true, h: 24 },
  { name: 'EngFlow', file: 'logo-engflow', onDark: true, h: 24 },
  { name: 'Google', file: 'logo-google', onDark: true, h: 24 },
];
---
<section class="bv" aria-labelledby="bv-title">
  <div class="container bv-head fade-up">
    <img
      class="bv-vl"
      src={`${base}/partners/virtuslab-logo-wide.svg`}
      alt="VirtusLab"
      width="96"
      height="40"
      loading="lazy"
    />
    <h2 id="bv-title" class="bv-title">{t.builtBy.title}</h2>
    <p class="bv-body">{t.builtBy.body}</p>
  </div>

  <div class="container">
    <ul class="bv-stats fade-up" role="list">
      {t.builtBy.stats.map((s) => (
        <li class="bv-stat">
          <p class="bv-stat-value">{s.value}</p>
          <p class="bv-stat-label">{s.label}</p>
        </li>
      ))}
    </ul>
  </div>

  {/*
    The arc: a very large circle whose top edge crosses the section, drawn as a
    2px prism ring and revealed left to right on scroll. Purely decorative, so
    aria-hidden and it degrades to a fully drawn arc without JS.
  */}
  <div class="arc" aria-hidden="true" id="bv-arc">
    <div class="arc-lines"></div>
    <div class="arc-viewport">
      <div class="arc-reveal">
        <span class="arc-ring arc-ring--glow"></span>
        <span class="arc-ring"></span>
      </div>
    </div>
  </div>
</section>

<section class="pt" aria-labelledby="pt-title">
  <div class="container pt-head fade-up">
    <span class="pt-badge">
      <span class="pt-badge-dot" aria-hidden="true"></span>
      {t.partners.badge}
    </span>
    <h2 id="pt-title" class="pt-title">{t.partners.title}</h2>
    <p class="pt-body">{t.partners.body}</p>
    <a class="btn-pill btn-primary" href="#contact" data-cta="see_visdom_partners" data-location="partners">
      {t.partners.cta}
    </a>
  </div>

  <div class="container">
    <ul class="pt-grid fade-up" role="list" aria-label={t.partners.gridAria}>
      {partners.map((p) => (
        <li class="pt-cell">
          <img
            class={`pt-logo${p.onDark ? ' pt-logo--light' : ''}`}
            src={`${base}/partners/${p.file}.svg`}
            alt={p.name}
            height={p.h}
            loading="lazy"
            decoding="async"
            style={`height:${p.h}px`}
          />
          {p.onDark && (
            <img
              class="pt-logo pt-logo--dark"
              src={`${base}/partners/${p.file}-on-dark.svg`}
              alt=""
              aria-hidden="true"
              height={p.h}
              loading="lazy"
              decoding="async"
              style={`height:${p.h}px`}
            />
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const arc = document.getElementById('bv-arc');
  if (arc) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      // Scrubbed rather than played: the arc draws in step with the scroll
      // position, which is what makes it read as one continuous gesture.
      const state = { p: 0 };
      arc.style.setProperty('--arc-p', '0');
      gsap.to(state, {
        p: 100,
        ease: 'none',
        scrollTrigger: {
          trigger: arc,
          start: 'top 92%',
          end: 'bottom 55%',
          scrub: 0.5,
        },
        onUpdate: () => arc.style.setProperty('--arc-p', String(state.p)),
      });
    }
    // Reduced motion keeps the CSS default of 100: fully drawn, never animated.
  }
</script>

<style>
  /* ── built by ── */
  .bv {
    padding: 5.5rem 0 0;
    background: var(--color-bg);
  }

  .bv-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    max-width: 56rem;
  }

  .bv-vl {
    height: 40px;
    width: auto;
    opacity: 0.9;
  }

  /* the wordmark is near-black, so it needs inverting on the dark theme */
  :global(.dark) .bv-vl {
    filter: invert(1) brightness(1.6);
  }

  .bv-title {
    font-family: var(--font-heading);
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--color-text);
    margin: 0;
  }

  .bv-body {
    font-size: var(--fs-lg);
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .bv-stats {
    display: grid;
    gap: 1.5rem;
    margin-top: 3.5rem;
  }

  @media (min-width: 640px) { .bv-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .bv-stats { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .bv-stat {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
    padding-left: 1.5rem;
    border-left: 2px solid var(--color-emerald);
  }

  .bv-stat-value {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
  }

  .bv-stat-label {
    font-size: var(--fs-base);
    color: var(--color-text-muted);
    margin: 0;
  }

  /*
   * ── the arc ───────────────────────────────────────────────────────────────
   *
   * A circle far wider than the page, pushed down so only its top edge crosses
   * the section: what you see is a shallow arc spanning the full width. Sized as
   * a percentage of the section rather than the source's fixed 1488px, so the
   * curvature stays the same at every viewport instead of flattening out.
   *
   * The ring is one element: a conic gradient clipped by a radial mask that
   * keeps only the outermost 2px, so there is no second opaque disc to cover the
   * interior. A blurred, thicker copy underneath provides the bloom.
   *
   * --arc-p is the reveal position, driven by scroll. At 0 nothing is drawn, at
   * 100 the whole arc is. Without JS it stays at 100.
   */
  .arc {
    --arc-p: 100;
    position: relative;
    margin-top: -2rem;
    overflow: hidden;
  }

  /* hairline verticals fading in downwards, behind the arc */
  .arc-lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      to right,
      color-mix(in oklab, var(--vmm-accent) 15%, transparent) 0 1px,
      transparent 1px 9px
    );
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, transparent 48%, #000 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, transparent 48%, #000 100%);
  }

  .arc-viewport {
    position: relative;
    height: clamp(220px, 30vw, 440px);
  }

  /* The left-to-right wipe, 8% of soft edge as on the source page. The mask is
     recomputed on every scroll frame, hence the hint. */
  .arc-reveal {
    position: absolute;
    inset: 0;
    will-change: mask-image;
    -webkit-mask-image: linear-gradient(
      to right,
      #000 calc(var(--arc-p) * 1%),
      transparent calc((var(--arc-p) + 8) * 1%)
    );
    mask-image: linear-gradient(
      to right,
      #000 calc(var(--arc-p) * 1%),
      transparent calc((var(--arc-p) + 8) * 1%)
    );
  }

  .arc-ring {
    position: absolute;
    left: 50%;
    top: clamp(70px, 9vw, 130px);
    width: 116%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: conic-gradient(
      from 90deg,
      rgb(161, 130, 141) 0deg,
      rgb(126, 134, 174) 43.2deg,
      rgb(71, 143, 225) 86.4deg,
      rgb(52, 162, 153) 129.6deg,
      rgb(59, 177, 98) 172.8deg,
      rgb(156, 176, 54) 216deg,
      rgb(190, 144, 50) 259.2deg,
      rgb(210, 125, 97) 302.4deg,
      rgb(161, 130, 141) 360deg
    );
    -webkit-mask-image: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
    mask-image: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
  }

  .arc-ring--glow {
    filter: blur(5px);
    opacity: 0.75;
    -webkit-mask-image: radial-gradient(farthest-side, transparent calc(100% - 5px), #000 calc(100% - 5px));
    mask-image: radial-gradient(farthest-side, transparent calc(100% - 5px), #000 calc(100% - 5px));
  }

  /* ── partners ── */
  .pt {
    padding: 5.5rem 0 4rem;
    background: var(--color-bg);
  }

  .pt-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.15rem;
    max-width: 56rem;
  }

  .pt-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 12px;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-text);
  }

  .pt-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--color-emerald);
  }

  .pt-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.4vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--color-text);
    margin: 0;
  }

  .pt-body {
    font-size: var(--fs-lg);
    line-height: 1.75;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /*
   * One hairline grid rather than twelve bordered cards: the cells draw only
   * their right and bottom edge and the container clips the overflow, so the
   * outer edge stays clean at every breakpoint without per-cell overrides.
   */
  .pt-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 3rem;
    border: 1px solid var(--color-border-light);
    border-radius: 14px;
    overflow: hidden;
  }

  @media (min-width: 700px) { .pt-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .pt-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .pt-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 112px;
    padding: 1.75rem 1.5rem;
    border-right: 1px solid var(--color-border-light);
    border-bottom: 1px solid var(--color-border-light);
  }

  .pt-logo {
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
  }

  /* the monochrome wordmarks swap; the colour icons have no --light/--dark pair
     and are simply never hidden */
  .pt-logo--dark { display: none; }
  :global(.dark) .pt-logo--light { display: none; }
  :global(.dark) .pt-logo--dark { display: block; }
</style>
