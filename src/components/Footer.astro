---
import { Footer as FooterReact } from '@virtuslab/visdom-ui';
import { useI18n } from '../i18n';

const { t } = useI18n(Astro);

// The upstream Footer defaults to English labels. Passing `links` keeps the
// same destinations while letting each locale name them.
const hrefs = [
  'https://virtuslab.com',
  'https://github.com/VirtusLab',
  'https://virtuslab.com/blog/ai/',
  'https://virtuslab.com/contact',
];
const links = t.footer.links.map((link, i) => ({ label: link.label, href: hrefs[i] }));
---
<div class="site-footer">
  <FooterReact links={links} client:load />
</div>
