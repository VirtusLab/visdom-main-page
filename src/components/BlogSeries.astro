---
import { useI18n } from '../i18n';

const { locale, t } = useI18n(Astro);

const BASE = 'https://virtuslab.com';

// Series names, article titles, links and cover images are the articles' own
// identity and stay as published; only the series blurbs and the surrounding
// chrome come from the dictionary. Dates are stored as ISO and formatted for
// the reader's locale.
const series = [
  {
    title: 'VISDOM',
    color: 'var(--color-emerald)',
    latest: {
      title: 'AI in the SDLC: Faster or Just Busier?',
      date: '2026-04-10',
      href: `${BASE}/blog/ai/ai-in-the-sdlc-faster-or-just-busier/`,
      image: 'blog-visdom.jpg',
    },
  },
  {
    title: 'GitHub All-Stars',
    color: 'var(--color-blue)',
    latest: {
      title: '#16: Project N.O.M.A.D. - Civilization in a Docker Container',
      date: '2026-03-25',
      href: `${BASE}/blog/ai/project-nomad/`,
      image: 'blog-github-all-stars.jpg',
    },
  },
  {
    title: 'AI-Insight',
    color: 'var(--color-purple)',
    latest: {
      title: 'Interview with Krzysztof Grajek, lead engineer behind Visdom AI Tracing',
      date: '2026-04-13',
      href: `${BASE}/blog/ai/interview-with-krzysztof-grajek-lead-engineer-behind-trace-vault/`,
      image: 'blog-ai-insight.jpg',
    },
  },
];

const dateFormat = new Intl.DateTimeFormat(locale, {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
const formatDate = (iso: string) => dateFormat.format(new Date(`${iso}T00:00:00Z`));
---
<section class="section" id="insights">
  <div class="container">
    <div id="thesis" class="fade-up writing-head">
      <p class="section-label">{t.writing.label}</p>
      <h2 class="section-title">{t.writing.title}</h2>
      <p class="section-subtitle">{t.writing.subtitle}</p>
    </div>

    <div class="writing-grid">
      {series.map((item, i) => (
        <article class="writing-card fade-up">
          <a href={item.latest.href} target="_blank" rel="noopener" class="writing-thumb" aria-label={item.latest.title}>
            <img src={`${(import.meta.env.BASE_URL || '/').replace(/\/$/, '')}/${item.latest.image}`} alt="" loading="lazy" width="1200" height="627" />
          </a>
          <div class="writing-card-line" style={`background: ${item.color}`}></div>
          <p class="writing-series">{item.title}</p>
          <p class="writing-description">{t.writing.series[i].description}</p>
          <a href={item.latest.href} target="_blank" rel="noopener" class="writing-latest">
            <span class="writing-latest-label">{t.writing.latestLabel}</span>
            <span class="writing-latest-title">{item.latest.title}</span>
            <time class="writing-latest-date" datetime={item.latest.date}>{formatDate(item.latest.date)}</time>
          </a>
          <a href={item.latest.href} target="_blank" rel="noopener" class="btn-pill btn-outline writing-link"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg>{t.writing.linkLabel}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .writing-head {
    max-width: 52rem;
    margin-bottom: 2.75rem;
  }

  .writing-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .writing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--card);
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.05);
    overflow: hidden;
  }

  .writing-thumb {
    display: block;
    margin: -1.5rem -1.5rem 0;
    aspect-ratio: 1200 / 627;
    overflow: hidden;
    background: var(--color-surface);
  }

  .writing-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .writing-thumb:hover img {
    transform: scale(1.02);
  }

  .writing-card-line {
    width: 100%;
    height: 3px;
    border-radius: 999px;
  }

  .writing-series {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .writing-description {
    margin: 0;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .writing-latest {
    display: grid;
    gap: 0.35rem;
    padding: 1rem;
    border-radius: 16px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .writing-latest:hover {
    border-color: var(--color-emerald);
    transform: translateY(-1px);
  }

  .writing-latest-label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .writing-latest-title {
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-text);
  }

  .writing-latest-date {
    font-size: var(--fs-md);
    color: var(--color-text-secondary);
  }

  .writing-link {
    align-self: flex-start;
  }

  @media (max-width: 1023px) {
    .writing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
