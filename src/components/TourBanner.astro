---
// Stops come from src/data/tour.ts so the banner and the webinar page cannot
// drift apart. Rendered markup is unchanged.
import { TOUR_STOPS, TOUR_HREF } from '../data/tour';
import { useI18n } from '../i18n';

const { t } = useI18n(Astro);

// tour.ts stores month labels in English. Anything without a translation (a
// full date, say) falls through as written rather than disappearing.
const when = (label: string) => t.tour.months[label] ?? label;
---
<a
  class="tour-banner"
  href={TOUR_HREF}
  target="_blank"
  rel="noopener"
  data-cta="cta_click"
  aria-label={t.tour.aria}
>
  <span class="tour-banner-tag">{t.tour.tag}</span>
  <span class="tour-banner-text">
    {TOUR_STOPS.map((stop, i) => (
      <>
        {i > 0 && <span class="tour-sep" aria-hidden="true">·</span>}
        {stop.status === 'next' ? (
          <span class="tour-stop tour-stop--next">
            <span class="tour-flag">{stop.flag}</span><strong>{stop.city}</strong>
            <span class="tour-next-badge">{t.tour.nextStop} {when(stop.when)}</span>
          </span>
        ) : (
          <span class="tour-stop tour-stop--upcoming">
            <span class="tour-flag">{stop.flag}</span>{stop.city}
            <span class="tour-month">{when(stop.when)}</span>
          </span>
        )}
      </>
    ))}
  </span>
</a>

<style>
  .tour-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    padding: 9px 20px;
    background: linear-gradient(90deg, #ecfdf5, #eff6ff);
    border-bottom: 1px solid color-mix(in oklab, var(--color-emerald, #10b981) 22%, transparent);
    color: #0f172a;
    text-decoration: none;
    font-size: var(--fs-md);
    line-height: 1.3;
    text-align: center;
    transition: filter 0.2s ease;
  }

  .tour-banner:hover {
    filter: brightness(0.98);
  }

  .tour-banner-tag {
    flex-shrink: 0;
    padding: 2px 9px;
    border-radius: 9999px;
    background: var(--color-emerald, #10b981);
    color: #fff;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .tour-banner-text {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 5px 9px;
    font-size: var(--fs-xs);
  }

  .tour-banner-text strong {
    font-weight: 700;
  }

  .tour-stop {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
  }

  .tour-flag {
    font-size: 0.95em;
    line-height: 1;
  }

  .tour-sep {
    opacity: 0.55;
  }

  .tour-stop--upcoming {
    color: color-mix(in oklab, #0f172a 62%, transparent);
  }

  .tour-stop--next {
    font-weight: 700;
  }

  .tour-next-badge {
    display: inline-flex;
    align-items: center;
    margin-left: 2px;
    color: var(--color-emerald-dark, #047857);
    font-family: var(--font-mono);
    font-size: var(--fs-4xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .tour-next-badge::before {
    content: "";
    width: 4px;
    height: 4px;
    margin-right: 5px;
    border-radius: 9999px;
    background: var(--color-emerald, #10b981);
  }

  .tour-month {
    display: inline-flex;
    align-items: center;
    margin-left: 1px;
    padding: 1px 6px;
    border-radius: 9999px;
    background: color-mix(in oklab, var(--color-emerald, #10b981) 14%, transparent);
    color: var(--color-emerald-dark, #047857);
    font-family: var(--font-mono);
    font-size: var(--fs-4xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

</style>
