---
import { useI18n } from '../i18n';

const { t } = useI18n(Astro);
---
<section class="section diagnosis-section" id="platform">
  <div class="container">
    <div class="fade-up diagnosis-head">
      <p class="section-label">{t.diagnosis.label}</p>
      <h2 class="section-title">{t.diagnosis.title}</h2>
      <p class="diagnosis-lead">{t.diagnosis.lead}</p>
    </div>

    <div class="fade-up diagnosis-body">
      <p class="diagnosis-kicker" id="diagnosis-reasons-label">{t.diagnosis.kicker}</p>
      <ul class="diagnosis-reasons" role="list" aria-labelledby="diagnosis-reasons-label">
        {t.diagnosis.pillars.map((r) => (
          <li class="diagnosis-reason">
            <span class="diagnosis-reason-key">{r.key}</span>
            <p class="diagnosis-reason-copy">{r.copy}</p>
          </li>
        ))}
      </ul>
      <p class="diagnosis-bridge">{t.diagnosis.bridge} <span aria-hidden="true">&darr;</span></p>
    </div>
  </div>
</section>

<style>
  .diagnosis-section {
    padding-top: 2.5rem;
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-surface) 100%);
  }

  .diagnosis-head {
    max-width: 56rem;
  }

  .diagnosis-lead {
    margin-top: 1.25rem;
    max-width: 54rem;
    font-size: var(--fs-2xl);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }

  .diagnosis-body {
    max-width: 46rem;
    margin-top: 3rem;
  }

  .diagnosis-kicker {
    margin: 0 0 2rem;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .diagnosis-reasons {
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .diagnosis-reason {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: baseline;
  }

  .diagnosis-reason-key {
    position: relative;
    padding-left: 2rem;
    font-family: var(--font-mono);
    font-size: var(--fs-md);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-emerald-dark);
  }

  .diagnosis-reason-key::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 1.5rem;
    height: 1px;
    background: var(--color-emerald);
  }

  .diagnosis-reason-copy {
    margin: 0;
    font-size: var(--fs-3xl);
    line-height: 1.6;
    color: var(--color-text);
  }

  .diagnosis-bridge {
    margin: 3rem 0 0;
    font-size: var(--fs-xl);
    color: var(--color-text-secondary);
  }

  @media (max-width: 640px) {
    .diagnosis-reason {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
    }
  }
</style>
