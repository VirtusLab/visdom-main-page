# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
# The site defaults to the production ID, so you only need this to override it,
# e.g. set PUBLIC_GA_ID= (empty) to disable analytics on a preview or locally.
PUBLIC_GA_ID=

# Sentry DSN for front-end error tracking (https://<key>@<org>.ingest.sentry.io/<id>).
# When empty, Sentry is not loaded at all. Set it to enable error reporting.
PUBLIC_SENTRY_DSN=

# ── Contact form (/api/contact) ───────────────────────────────────────────────
# Mailchimp Transactional (Mandrill) key. The same credential the Maturity Matrix
# uses, so the mail goes out from the verified send.virtuslab.com domain. Without
# it the form returns 502 and the visitor is shown the mailto fallback.
# Server-side only: never rename this to PUBLIC_.
MAILCHIMP_API_KEY=

# Optional. Sender, in "Name <addr@host>" form. Defaults to
# "Visdom <noreply@send.virtuslab.com>".
ACCESS_REQUEST_FROM=

# Optional. Comma-separated override of the notification recipients. Unset, the
# production domain notifies the offer owners and every other host notifies a
# single dev address, so a preview submission cannot page the whole team.
CONTACT_NOTIFY_TO=
