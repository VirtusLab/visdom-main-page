# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
# The site defaults to the production ID, so you only need this to override it,
# e.g. set PUBLIC_GA_ID= (empty) to disable analytics on a preview or locally.
PUBLIC_GA_ID=

# Sentry DSN for front-end error tracking (https://<key>@<org>.ingest.sentry.io/<id>).
# When empty, Sentry is not loaded at all. Set it to enable error reporting.
PUBLIC_SENTRY_DSN=

# ── Contact form (/api/contact), HubSpot ──────────────────────────────────────
# The form writes the lead to HubSpot, and HubSpot sends every email. Two
# channels, either of which is enough for the endpoint to report success:
#
#   A. The form submission (no add-on needed). Set PORTAL_ID and FORM_GUID. The
#      contact lands in the CRM, and the HubSpot form's own settings decide who is
#      notified and whether the visitor gets a follow-up email.
#   B. Transactional Single-Send emails (needs the transactional email add-on).
#      Set ACCESS_TOKEN and the template IDs below.
#
# With neither configured the form returns 502 and the visitor sees the mailto
# fallback. See README for the portal-side setup.

# Hub ID / portal ID, the number in the HubSpot URL (Settings, Account setup).
HUBSPOT_PORTAL_ID=

# GUID of the form to submit to, from the form editor's URL or share code.
HUBSPOT_FORM_GUID=

# Private app access token (starts with pat-). Server-side only: never rename
# this to PUBLIC_. Scopes: `forms` for the authenticated submission endpoint, and
# `transactional-email` to send Single-Send emails. With no token the submission
# still works, against the public endpoint.
HUBSPOT_ACCESS_TOKEN=

# Optional. Content ID of the transactional template that notifies the team.
# Numeric, from the email tool's URL. Leave empty to let the HubSpot form's own
# notification settings do it, which is the usual setup.
HUBSPOT_NOTIFY_EMAIL_ID=

# Optional. Content ID of the transactional template that confirms to the
# visitor. Leave empty when the form sends its own follow-up email.
HUBSPOT_CONFIRM_EMAIL_ID=

# Optional. Sender override in "Name <addr@host>" form. Unset, HubSpot uses the
# template's own sender, which is the address you connected in HubSpot.
HUBSPOT_FROM=

# Optional. Subscription type ID, required only when the form has GDPR consent
# options turned on. Submissions are recorded as legitimate interest, basis LEAD.
HUBSPOT_SUBSCRIPTION_TYPE_ID=

# Optional. Set to 1 to let localhost and preview hosts write real contacts into
# the CRM, e.g. when pointing them at a sandbox portal. Unset, they skip the CRM
# write so a test submission cannot look like a lead.
HUBSPOT_ALLOW_DEV_SUBMIT=

# Optional. Comma-separated override of the transactional notification
# recipients. Unset, the production domain notifies the offer owners and every
# other host notifies a single dev address, so a preview submission cannot page
# the whole team. Has no effect on the notifications HubSpot sends itself.
CONTACT_NOTIFY_TO=
